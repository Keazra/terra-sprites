TSPRƒ®schema_version«sim_version¥0.1.0¨checksumÏÀèô‰e–@“…¤seed¦configÀ¤pack›’¨pack.ronÙ—// The default Terra Sprites data pack. Embedded in the binary; `--data <dir>`
// overrides it for new worlds.
(
    name: "core",
    version: "1",
)
’«terrain.ronÚu// Terrain properties (design Â§3.1). Every terrain must be listed.
//
// A walkable terrain gives its step cost (what an orthogonal step onto it
// costs; a diagonal step costs 14/10 of that), its fertility (0 to 1) and
// whether sprites can drink there, and whether a fixture (such as a bush) may
// stand there. An unwalkable terrain gives only `walkable: false`.
{
    grass:         (walkable: true, step_cost: 10, fertility: 1.0, drinkable: false, allows_fixtures: true),
    dirt:          (walkable: true, step_cost: 10, fertility: 0.5, drinkable: false, allows_fixtures: true),
    sand:          (walkable: true, step_cost: 15, fertility: 0.0, drinkable: false, allows_fixtures: true),
    shallow_water: (walkable: true, step_cost: 25, fertility: 0.0, drinkable: true,  allows_fixtures: false),
    deep_water:    (walkable: false),
    rock:          (walkable: false),
}
’­chemicals.ronÚß// The chemicals registry (design Â§4.1, Appendix A). IDs are stable and
// append-only: never renumber or reuse one.
//
// Classes: Physical chemicals are changed only by physiology and object verbs;
// Signal chemicals (drives, reward, punishment) and Hormones by the genome.
// Only Physical chemicals may be the target of an object verb's `Inject`.
[
    (id: 1,  name: "energy",      class: Physical),
    (id: 2,  name: "hydration",   class: Physical),
    (id: 3,  name: "stamina",     class: Physical),
    (id: 4,  name: "food",        class: Physical),
    (id: 5,  name: "water",       class: Physical),
    (id: 6,  name: "injury",      class: Physical),

    (id: 16, name: "hunger",      class: Signal),
    (id: 17, name: "thirst",      class: Signal),
    (id: 18, name: "pain",        class: Signal),
    (id: 19, name: "tiredness",   class: Signal),
    (id: 20, name: "boredom",     class: Signal),
    (id: 21, name: "loneliness",  class: Signal),
    (id: 22, name: "crowdedness", class: Signal),
    (id: 23, name: "reward",      class: Signal),
    (id: 24, name: "punishment",  class: Signal),
    // The drive to breed (M2 design Â§10).
    (id: 25, name: "arousal",     class: Signal),

    (id: 32, name: "h0",  class: Hormone),
    (id: 33, name: "h1",  class: Hormone),
    (id: 34, name: "h2",  class: Hormone),
    (id: 35, name: "h3",  class: Hormone),
    (id: 36, name: "h4",  class: Hormone),
    (id: 37, name: "h5",  class: Hormone),
    (id: 38, name: "h6",  class: Hormone),
    (id: 39, name: "h7",  class: Hormone),
    (id: 40, name: "h8",  class: Hormone),
    (id: 41, name: "h9",  class: Hormone),
    (id: 42, name: "h10", class: Hormone),
    (id: 43, name: "h11", class: Hormone),
    (id: 44, name: "h12", class: Hormone),
    (id: 45, name: "h13", class: Hormone),
    (id: 46, name: "h14", class: Hormone),
    (id: 47, name: "h15", class: Hormone),

    // The hormone that turns a male female, once it's above the level in
    // physiology's `breeding` (M2 design Â§10).
    (id: 48, name: "feminiser",  class: Hormone),
    // Longing builds while a sprite sees no male adult; in the starter
    // genome it's what leads a female to breed alone (M2 design Â§10).
    (id: 49, name: "longing",    class: Hormone),
]
’¨loci.ronÚ†// The loci registry (design Â§4.2, Appendix A): the named values genes and
// verbs read and write. IDs are stable and append-only: never renumber or
// reuse one. Chemical levels are loci too, referred to as `Chem(id)`, so
// they aren't listed here.
//
// Kinds: BodySensor (physiology fills it in every tick), Pulse (an event that
// lasts one tick; object verbs `Signal` these) and ReceptorTarget (written by
// receptors). Which of them the brain feels is listed in `brain_io.ron`.
[
    (id: 1,  name: "always",            kind: BodySensor),
    (id: 2,  name: "age",               kind: BodySensor),
    (id: 3,  name: "nearby_sprites",    kind: BodySensor),
    (id: 4,  name: "moving",            kind: BodySensor),
    (id: 5,  name: "resting",           kind: BodySensor),
    // Breeding (M2 design Â§10): 1 while it's fertile, 1 if it's female, 1
    // while it sees a female adult, and 1 while it sees a male adult.
    (id: 6,  name: "fertile",           kind: BodySensor),
    (id: 7,  name: "female",            kind: BodySensor),
    (id: 8,  name: "female_near",       kind: BodySensor),
    (id: 9,  name: "male_near",         kind: BodySensor),

    (id: 32, name: "ate",               kind: Pulse),
    (id: 33, name: "drank",             kind: Pulse),
    (id: 34, name: "played",            kind: Pulse),
    (id: 35, name: "played_social",     kind: Pulse),
    (id: 36, name: "pricked",           kind: Pulse),
    (id: 37, name: "was_hit",           kind: Pulse),
    (id: 38, name: "did_hit",           kind: Pulse),
    (id: 39, name: "petted",            kind: Pulse),
    (id: 40, name: "shocked",           kind: Pulse),
    (id: 41, name: "cornered",          kind: Pulse),  // a retreat found no step away
    (id: 42, name: "fruitless",         kind: Pulse),  // a try that did nothing (design v16 Â§5.2)
    (id: 43, name: "bred",              kind: Pulse),  // it laid an egg or fathered one (M2 design Â§10)

    (id: 64, name: "learning_rate_mod", kind: ReceptorTarget),
    (id: 65, name: "exploration_mod",   kind: ReceptorTarget),
    (id: 66, name: "curiosity_mod",     kind: ReceptorTarget),  // wariness lowers it (design v16 Â§5.3)
]
’¬brain_io.ronÚt// The brain's State inputs (design Â§5.2, Appendix A): what a sprite's brain
// feels, each reading a drive, a hormone, a body sensor or a pulse. IDs are
// stable and append-only: never renumber or reuse one. An input that reads
// `Target(...)` reads the same in the body of the sprite attended to, its body
// language, and one that reads `Differs(...)` how far that differs from the
// sprite's own (M2 design Â§10).
//
// Not brain inputs: physical chemicals (the brain feels the body only through
// drives), reward and punishment (learning signals), the `moving` and
// `resting` sensors (as inputs they'd loop an action back into itself) and
// receptor targets. The Target inputs are one for each category in
// categories.ron, attended_<category>, then target_distance (42) and
// target_adjacent (43), and IDs 36 to 63 are kept for them, so State inputs
// carry on from 64.
(
inputs: [
    (id: 1,  name: "hunger",        reads: Chem("hunger")),
    (id: 2,  name: "thirst",        reads: Chem("thirst")),
    (id: 3,  name: "pain",          reads: Chem("pain")),
    (id: 4,  name: "tiredness",     reads: Chem("tiredness")),
    (id: 5,  name: "boredom",       reads: Chem("boredom")),
    (id: 6,  name: "loneliness",    reads: Chem("loneliness")),
    (id: 7,  name: "crowdedness",   reads: Chem("crowdedness")),

    (id: 8,  name: "h0",            reads: Chem("h0")),
    (id: 9,  name: "h1",            reads: Chem("h1")),
    (id: 10, name: "h2",            reads: Chem("h2")),
    (id: 11, name: "h3",            reads: Chem("h3")),
    (id: 12, name: "h4",            reads: Chem("h4")),
    (id: 13, name: "h5",            reads: Chem("h5")),
    (id: 14, name: "h6",            reads: Chem("h6")),
    (id: 15, name: "h7",            reads: Chem("h7")),
    (id: 16, name: "h8",            reads: Chem("h8")),
    (id: 17, name: "h9",            reads: Chem("h9")),
    (id: 18, name: "h10",           reads: Chem("h10")),
    (id: 19, name: "h11",           reads: Chem("h11")),
    (id: 20, name: "h12",           reads: Chem("h12")),
    (id: 21, name: "h13",           reads: Chem("h13")),
    (id: 22, name: "h14",           reads: Chem("h14")),
    (id: 23, name: "h15",           reads: Chem("h15")),

    (id: 24, name: "nearby_sprites",reads: Locus("nearby_sprites")),
    (id: 25, name: "age",           reads: Locus("age")),
    (id: 26, name: "always",        reads: Locus("always")),

    (id: 27, name: "ate",           reads: Locus("ate")),
    (id: 28, name: "drank",         reads: Locus("drank")),
    (id: 29, name: "played",        reads: Locus("played")),
    (id: 30, name: "played_social", reads: Locus("played_social")),
    (id: 31, name: "pricked",       reads: Locus("pricked")),
    (id: 32, name: "was_hit",       reads: Locus("was_hit")),
    (id: 33, name: "did_hit",       reads: Locus("did_hit")),
    (id: 34, name: "petted",        reads: Locus("petted")),
    (id: 35, name: "shocked",       reads: Locus("shocked")),

    (id: 64, name: "cornered",      reads: Locus("cornered")),
    (id: 65, name: "fruitless",     reads: Locus("fruitless")),

    // Breeding (M2 design Â§10).
    (id: 66, name: "arousal",       reads: Chem("arousal")),
    (id: 67, name: "fertile",       reads: Locus("fertile")),
    (id: 68, name: "female",        reads: Locus("female")),
    (id: 69, name: "female_near",   reads: Locus("female_near")),
    (id: 70, name: "bred",          reads: Locus("bred")),
    // Body language: what the sprite attended to shows, 0 unless attention
    // is on a sprite that has hatched: how aroused it is, and whether it's
    // of the other sex.
    (id: 71, name: "target_arousal",   reads: Target(Chem("arousal"))),
    (id: 72, name: "target_other_sex", reads: Differs(Locus("female"))),
    // How long it's gone without seeing a male adult.
    (id: 73, name: "longing",       reads: Chem("longing")),
],

// The needs (design v16 Â§5.2, Â§5.6): the drives whose relief teaches a
// sprite what things are good for, each a State input that reads a drive.
// Pain is a drive but not a need: its fall is a hurt fading, not relief.
needs: ["hunger", "thirst", "tiredness", "boredom", "loneliness", "crowdedness", "arousal"],

// The first-order needs (design v21 Â§5.2, Â§5.6): the needs that come before a
// sprite's likes. The more one presses, the less what it merely likes pulls,
// though never to nothing. The other needs are second-order.
first_order: ["hunger", "thirst"],
)
’®categories.ronÚ*// Categories (design v19 Â§3.5.5): what a sprite perceives a thing as. Things
// share a category because they look alike to a sprite, never because of what
// they do to it: a bush and a berry are different categories, though berries
// grow on bushes. IDs are permanent and append-only: never renumber or reuse
// one. Each category's brain input, attended_<name>, takes the ID 35 + id for
// IDs 1 to 6, and 37 + id from 7, so category IDs go up to 26.
//
// Each category has:
//   name    what object types, genomes and brain inputs call it
//   plural  how the screen says the category in general, as written:
//           "bushes"; left out for one you don't count, such as water
[
    (id: 1, name: "bush",      plural: "bushes"),
    (id: 2, name: "fruit"),
    // 3 was thornbush, until thornbushes joined bush (design v20). Never reuse it.
    (id: 4, name: "water"),
    (id: 5, name: "toy",       plural: "toys"),
    (id: 6, name: "sprite",    plural: "sprites"),
    // The Cursor, which sprites see while it's visible (design v29 Â§6.5).
    // There's one, so it has no plural.
    (id: 7, name: "cursor"),
    // Eggs, which sprites see as a kind of thing of their own, not as
    // sprites (M2 design Â§10). A pack without it has eggs no sprite sees.
    (id: 8, name: "egg",       plural: "eggs"),
]
’¨tags.ronÚî// Tags defined in the data (design v23 Â§3.5.6). A contact is a sprite
// touching a thing: eating it, hitting it, playing with it, or crashing into
// it. A tag says what each contact with a thing that has it does to the sprite
// making it, and every thing with the tag behaves the same way. An object type
// names its tags in `objects.ron`, after the built-in Solid and Fixture.
//
// Each tag has:
//   name     what object types call it
//   contact  for each contact (Eat, Hit, Play, Crash), its effects, run before
//            the thing's own verb table. Only Inject and Signal on the Actor,
//            the sprite making contact, are allowed
[
    (name: "Thorny",
     contact: {
         Eat:   [Inject(Actor, "injury", 0.05), Signal(Actor, "pricked")],
         Hit:   [Inject(Actor, "injury", 0.03), Signal(Actor, "pricked")],
         Play:  [Inject(Actor, "injury", 0.03), Signal(Actor, "pricked")],
         Crash: [Inject(Actor, "injury", 0.03), Signal(Actor, "pricked")],
     }),
]
’«objects.ronÚQ// Object types (design Â§3.5). IDs are stable and append-only: never renumber
// or reuse one. Names are what rules, presets and themes refer to.
//
// Each type has:
//   plural    how the screen says the kind in general, as written: "berry bushes";
//             left out for a thing you don't count, such as water ("water is")
//   category  what brains perceive it as: a category's name from categories.ron
//   tags      [Solid, Fixture] for objects like bushes, which nothing can move
//             through or move; no tags for items, like berries and balls. Then
//             any tags defined in tags.ron, such as Thorny, whose contacts run
//             before the type's own verbs
//   size      Small, Medium or Large, and
//   hardness  from 0 to 1: a rolling item bounces off something bigger, knocks
//             on something its size, and crushes something smaller and softer.
//             Every type with objects gives both; a pseudo type gives both or neither
//   counters  named whole numbers with maximums: {"fruit": 6}
//   stages    [(name, ticks: (min, max), next: Stage(name) or Expire)]; a type
//             with no stages is permanent
//   rules     [(trigger, if: [conditions], do: [effects])], run in order
//   verbs     {Verb: [effects]}: what happens when a sprite does that verb to it
//   visual    [(if: [conditions], state: name)]: the first match names the state
//             themes draw; with no match, the state is "default"
//   place     (label: "...", if: [conditions]) if the Cursor's Place menu offers
//             it (design v28 Â§3.5.1), under that label. A placed object starts at the
//             beginning of its first stage. `if` is optional: the conditions its
//             tile must meet, such as KeepsPathsOpen; Chance isn't allowed
//
// Triggers: Every(n), OnStageEnter(stage), OnExpire.
// Conditions: InStage(stage), Counter(name, cmp, n), Chance(p),
//   Fertility(cmp, f), DensityBelow(type, radius, max), KeepsPathsOpen;
//   cmp is Lt, Le, Eq, Ne, Ge or Gt. KeepsPathsOpen holds where a solid object
//   wouldn't split the open tiles around it: ask it before making one.
// Effects: AddCounter(name, delta), SpawnNearby(type, radius),
//   SpreadTo(type, radius, [conditions]), ReplaceWith(type), DestroySelf;
//   and in verbs only: RequireCounter(name, n), Inject(Actor or Target, chemical, amount),
//   Signal(Actor or Target, locus), Push(tiles).
[
    (id: 1, name: "berry_bush", plural: "berry bushes",
     category: "bush", tags: [Solid, Fixture], size: Large, hardness: 1.0,
     counters: {"fruit": 6},
     stages: [
         (name: "seedling", ticks: (1500, 2500),   next: Stage("mature")),
         (name: "mature",   ticks: (20000, 30000), next: Expire),
     ],
     rules: [
         (trigger: Every(200), if: [InStage("mature")], do: [AddCounter("fruit", 1)]),
         // Overripe fruit drops beside the bush.
         (trigger: Every(50), if: [Counter("fruit", Ge, 6), Chance(0.2)],
          do: [AddCounter("fruit", -1), SpawnNearby("berry", 1)]),
     ],
     verbs: {
         Eat: [RequireCounter("fruit", 1), AddCounter("fruit", -1),
               Inject(Actor, "food", 0.3), Signal(Actor, "ate")],
         Hit: [Signal(Actor, "did_hit")],
     },
     visual: [
         (if: [InStage("seedling")], state: "seedling"),
         (if: [Counter("fruit", Ge, 1)], state: "fruiting"),
     ],
     // Placed anywhere a bush may stand, even where it walls things off: the
     // player may pen sprites in on purpose (design v28 Â§3.5.1).
     place: (label: "berry bush seedling"),
    ),

    (id: 2, name: "berry", plural: "berries", category: "fruit", size: Small, hardness: 0.1,
     stages: [(name: "fresh", ticks: (1500, 2500), next: Expire)],
     rules: [
         // An expiring berry sometimes sprouts, on fertile land that isn't crowded,
         // where a bush wouldn't cut a path.
         (trigger: OnExpire,
          if: [Fertility(Ge, 0.5), DensityBelow("berry_bush", 4, 3), KeepsPathsOpen, Chance(0.1)],
          do: [ReplaceWith("berry_bush")]),
     ],
     verbs: {
         Eat: [Inject(Actor, "food", 0.3), Signal(Actor, "ate"), DestroySelf],
     },
     place: (label: "berry"),
    ),

    (id: 3, name: "thornbush", plural: "thornbushes",
     category: "bush", tags: [Solid, Fixture, Thorny], size: Large, hardness: 1.0,
     stages: [(name: "grown", ticks: (40000, 60000), next: Expire)],
     rules: [
         (trigger: Every(2000), if: [Chance(0.1)],
          do: [SpreadTo("thornbush", 4, [DensityBelow("thornbush", 4, 2), KeepsPathsOpen])]),
     ],
     // Every contact hurts, deliberately, even Play (design Â§3.5.3): its
     // thorns are its Thorny tag's (tags.ron), so its own table has only
     // what isn't thorns.
     verbs: {
         Hit: [Signal(Actor, "did_hit")],
     }),

    (id: 4, name: "ball", plural: "balls", category: "toy", size: Medium, hardness: 0.5,
     verbs: {
         Play: [Push(4), Signal(Actor, "played")],
         Hit:  [Push(2), Signal(Actor, "did_hit")],
     },
     place: (label: "ball"),
    ),

    // Pseudo types: a verb table only, with no instances or lifecycle.
    // Water has no plural: it isn't counted, so it reads "water is".
    (id: 100, name: "water", category: "water", pseudo: true,
     verbs: {
         Drink: [Inject(Actor, "water", 0.2), Signal(Actor, "drank")],
     }),

    (id: 101, name: "sprite", plural: "sprites",
     category: "sprite", pseudo: true, size: Large, hardness: 0.5,
     verbs: {
         Hit:  [Inject(Target, "injury", 0.03), Signal(Target, "was_hit"), Signal(Actor, "did_hit")],
         Play: [Signal(Actor, "played_social"), Signal(Target, "played_social")],
     }),

    // The Cursor, which sprites see while it's visible (design v29 Â§6.5).
    // It's hard light, so every try on it is fruitless; a pack may give it
    // verbs, such as Play for chasing the light.
    (id: 102, name: "cursor", category: "cursor", pseudo: true, verbs: {}),

    // An egg (M2 design Â§10). Nothing a sprite tries on one does anything
    // yet: an egg can't be hurt until something in the world is meant to.
    (id: 103, name: "egg", plural: "eggs", category: "egg", pseudo: true, verbs: {}),
]
’®physiology.ronÚ7¸// Physiology (design Â§4.4, Appendix B): the body's fixed rules, which genes
// can't change. Levels are fractions of full, from 0 to 1; rates are per tick.
//
// The starting values aim for these timescales, for a sprite at rest: full
// hydration lasts about 3,000 ticks and full energy about 6,000; once either
// runs out, injury kills in about 1,000 more; an old sprite whose body has
// given out dies within about 2,000. Slice 17 tunes them.
(
    // What a newborn's physical chemicals start at. Injury and gut contents start at 0.
    newborn: (energy: 1.0, hydration: 1.0, stamina: 1.0),
    // The first population, placed by world generation, starts with its energy
    // and its hydration each drawn between these fractions of the newborn level.
    first_population: (0.6, 1.0),

    metabolism: (
        basal: 0.0001,              // energy per tick
        per_sense_tile: 0.0000067,  // energy per tick, per tile of sense radius
        per_step: 0.0002,           // energy per step at speed 8; scales with (speed / 8)Â²
    ),
    // Gut contents moved into the body per tick: food into energy, water into hydration.
    digestion: (food: 0.001, water: 0.002),
    hydration_loss: 0.00033,
    stamina: (per_step: 0.002, idle: 0.0005, resting: 0.002),
    healing: 0.0001,  // injury healed per tick
    // Injury per tick while energy is at 0, while hydration is at 0, and once
    // an old body has given out.
    injury: (starvation: 0.0011, dehydration: 0.0011, old_age: 0.0006),
    // Growing up and growing old (M2 design Â§9). First guesses, tuned in play
    // and in the viability run with A4 holding.
    ageing: (
        // A newborn walks at this share of its speed, rising steadily to all
        // of it when it grows up.
        young_speed: 0.67,
        // The energy growing up takes, spread evenly over childhood, so a
        // sprite that grows up sooner is a hungrier child.
        growth: 0.3,
        // Energy per tick, all its life, for every 10,000 ticks of
        // `grows_old`, for a pack that wants a later old age to cost
        // something. 0 here, the owner's call (M2 design Â§12): lives end as
        // the body and brain fail, not by an energy charge, so they may
        // grow long.
        upkeep: 0.0,
        // Wear from a hard life, which never heals: per tick while energy
        // is below `low` (starving) or hydration is (parched), and per tick
        // for each unit of injury. The most worn sprite grows old `sooner`
        // (a share of the age its genes say), and its genes then decay
        // `wear_speedup` times as fast.
        wear: (low: 0.25, starving: 0.0002, parched: 0.0002, injured: 0.001),
        wear_speedup: 3.0,
        sooner: 0.33,
        // Old, its repair no longer keeps up: damage lands on random genes,
        // `hit` health at a time (half that on an instinct), so its genes
        // fall to `gives_out` on average in `ticks` for an unworn sprite.
        // There its body gives out and old age harms it, so that old age
        // lasts about an hour at 1x (M2 design Â§2).
        decay: (ticks: 3600, hit: 0.01, gives_out: 0.5),
        // While its injury is above `above`, each tick a random gene may be
        // scarred, losing `hit` health for good, at any age.
        scar: (above: 0.5, chance: 0.002, hit: 0.05),
    ),
    // Having young (M2 design Â§10). An egg hatches after `hatches` ticks (10
    // minutes at 1x). It costs its parents `cost` energy in all, split
    // between them, or all of it for one breeding alone. An adult is fertile
    // while its energy and hydration are both above `fed`, and `rest` ticks
    // or more after its last egg. Every sprite hatches male; an adult male
    // turns female for good once its `feminiser` hormone is above
    // `turns_female`. A female can breed alone only once her `longing`
    // hormone has reached `breeds_alone`. The need `drive` drives breeding:
    // whatever the genes, it works only between adults, and what easing it
    // teaches is only about the partner (M2 design Â§5). A pair's egg takes
    // its genes from one parent in stretches: at each gene it switches to
    // the other with the chance `crossover` (M2 design Â§12).
    breeding: (
        hatches: 750,
        cost: 0.3,
        fed: 0.5,
        rest: 1500,
        turns_female: 0.8,
        breeds_alone: 0.5,
        drive: "arousal",
        crossover: 0.1,
    ),
    // Each cause-of-death tally halves every this many ticks (design Â§4.10).
    cause_fade: 350,

    // The range each trait gene is clamped to (design Â§4.8).
    traits: (
        speed: (4.0, 12.0),
        sense_radius: (6.0, 14.0),
        // The ages a sprite grows old and grows up at (M2 design Â§9.3).
        grows_old: (6000.0, 60000.0),
        grows_up: (1500.0, 13500.0),
    ),
    // Each brain parameter's range, which a `BrainParam` gene is clamped to,
    // and the value a genome with no gene for it gets (design Â§5.7, Appendix B).
    brain: {
        "learning_rate":     (range: (0.001, 0.5),   default: 0.05),
        "trace_decay":       (range: (0.5, 0.99),    default: 0.9),
        "relax_rate":        (range: (0.0, 0.01),    default: 0.001),
        "consolidate_rate":  (range: (0.0, 0.001),   default: 0.0001),
        "tau_base":          (range: (0.05, 2.0),    default: 0.2),
        "tau_att_base":      (range: (0.05, 2.0),    default: 0.2),
        "switch_margin":     (range: (0.0, 1.0),     default: 0.2),
        "attention_margin":  (range: (0.0, 1.0),     default: 0.2),
        "salience_gain":     (range: (0.0, 2.0),     default: 0.5),
        "pool_size":         (range: (0.0, 64.0),    default: 32.0),
        "max_arity":         (range: (1.0, 3.0),     default: 3.0),
        "recruit_threshold": (range: (0.0, 1.0),     default: 0.3),
        "novelty_threshold": (range: (0.0, 1.0),     default: 0.5),
        "forget_ticks":      (range: (100.0, 100000.0), default: 5000.0),
        // Learning (design v16 Â§5.6). Since v16 learning_rate, relax_rate and
        // consolidate_rate do nothing, nor do pool_size to forget_ticks while
        // the recruitable pool is on hold; genomes may still carry them.
        // Lessons fade slowly (design Â§5.6): a good one by half in about
        // 28,000 ticks, 6 hours at 1x, an average life; a bad one, and fear,
        // in about 110,000, so in effect it lasts a life.
        "worth_rate_good":   (range: (0.0, 1.0),     default: 0.5),
        "worth_rate_bad":    (range: (0.0, 1.0),     default: 0.8),
        "worth_fade_good":   (range: (0.0, 0.01),    default: 0.000025),
        "worth_fade_bad":    (range: (0.0, 0.01),    default: 0.00000625),
        "habit_rate":        (range: (0.0, 1.0),     default: 0.3),
        "habit_fade":        (range: (0.0, 0.01),    default: 0.000025),
        "value_gain":        (range: (0.0, 2.0),     default: 1.0),
        "curiosity":         (range: (0.0, 1.0),     default: 0.3),
        "familiarity_rate":  (range: (0.0, 0.05),    default: 0.002),
        "disappointment":    (range: (0.0, 1.0),     default: 0.3),
        // Individuals and fear (design v18 Â§5.3, Â§5.5, Â§5.6), from slice 9c's
        // prototype (#62).
        "individual_rate_good": (range: (0.0, 1.0),  default: 0.8),
        "individual_rate_bad":  (range: (0.0, 1.0),  default: 0.9),
        "fear_rate":         (range: (0.0, 1.0),     default: 1.0),
        "fear_fade":         (range: (0.0, 0.01),    default: 0.00000625),
        "generalise":        (range: (2.0, 10.0),    default: 3.0),
        "vigilance":         (range: (0.0, 2.0),     default: 0.8),
        "flight":            (range: (0.0, 2.0),     default: 0.8),
        "fear_reach":        (range: (0.1, 1.0),     default: 0.5),
        // Category summaries (design v19 Â§5.6), at generalise's value.
        "generalise_types":  (range: (2.0, 10.0),    default: 3.0),
        // A pressing first-order need quiets what a sprite merely likes, by
        // at most this much, never all of it; and bad habits fade as slowly
        // as bad things (design v21 Â§5.6).
        "quieting":          (range: (0.0, 1.0),     default: 0.8),
        "habit_fade_bad":    (range: (0.0, 0.01),    default: 0.00000625),
        // Fear of the Cursor wears off while it stays near and does nothing,
        // fastest on the sprite's own tile (design v29 Â§5.6): a sprite comes
        // to see it can't do anything about it. A first guess, tuned in play.
        "cursor_calming":    (range: (0.0, 0.1),     default: 0.01),
        // How much a remembered place fades each tick (M2 design Â§7):
        // by half in about 3,500 ticks. A place can change, as a bush dies,
        // so it fades faster than a lesson.
        "place_fade":        (range: (0.0, 0.01),    default: 0.0002),
        // Every learning rate is multiplied by it (M2 design Â§9.5): the
        // starter genome's young learn faster.
        "plasticity":        (range: (0.25, 4.0),    default: 1.0),
        // Taught habits: 3x habit_rate, fading as slowly as a bad lesson
        // (design Â§5.6, #187).
        "taught_rate":       (range: (0.0, 1.0),     default: 0.9),
        "taught_fade":       (range: (0.0, 0.01),    default: 0.00000625),
    },
    // The range of each receptor target in `loci.ron`. Each rests at 1.0 when
    // no receptor writes it.
    receptor_targets: {
        "learning_rate_mod": (0.5, 2.0),
        "exploration_mod": (0.25, 4.0),
        "curiosity_mod": (0.0, 2.0),
    },

    // The `nearby_sprites` body sensor counts the other sprites within
    // `radius` tiles, in any direction, and reads 1 at `full` of them.
    nearby_sprites: (radius: 3, full: 4),

    // Spawn variation (design Â§4.9): each gene value is multiplied by a factor
    // drawn between 1 âˆ’ this and 1 + this.
    spawn_variation: 0.1,
    // A trait named here varies by its own share instead (M2 design Â§9.3):
    // the age a sprite grows old at, by up to 40%, so that lives last from
    // about 4 hours to about 8 at 1x (M2 design Â§2).
    trait_variation: { "grows_old": 0.4 },
    // Copying errors (M2 design Â§12): when an egg is laid, each gene value
    // has `chance` of changing, so about one hatchling in two has a change.
    // Rare and mostly large, so they show: a `large.share` of the changes
    // are a factor from 1 / `large.most` to `large.most`, the rest small, a
    // factor between 1 âˆ’ `small` and 1 + `small`. First guesses.
    mutation: (chance: 0.01, small: 0.2, large: (share: 0.75, most: 2.0)),
    // Hidden flaws (M2 design Â§12): a sprite has two copies of each gene
    // that can weaken, one from each parent, and one sound copy is enough.
    // As an egg's genes are copied, each sound copy gets a flaw with the
    // chance `arise`, so about one egg in two has a new one. A sprite made
    // from the starter genome carries a flaw in one copy of each such gene
    // with the chance `founders`: about three each. A gene with both copies
    // flawed is broken: it's born with `health`, and counts as `wear` of
    // wear, bringing old age sooner (M2 design Â§9.4). First guesses.
    flaws: (arise: 0.007, founders: 0.06, health: 0.5, wear: 0.05),
    // Copy and change (M2 design Â§13): as an egg's genes are copied, each
    // gene is now and then doubled, lost, or changed in what it does: what
    // an instinct reacts to or its action, what draws the eye to what, or
    // the life stages it works in. So about one hatchling in ten has a gene doubled,
    // lost or changed. `on_copy` of the changes are made on a fresh copy, so
    // the original still works. A genome never grows past `longest` times the
    // starter's length. First guesses.
    copy_and_change: (doubled: 0.00052, lost: 0.00052, changed: 0.00052, on_copy: 0.75, longest: 2.0),

    // A learned value this far from 0 is a lesson, which the event log
    // announces once (design v16 Â§5.6).
    lesson_threshold: 0.5,

    // Learning (design v16 Â§5.6): the least fall of a need in a tick that
    // counts as relief, and how many ticks after a try the thing tried on
    // is still the thing a feeling is about.
    relief_deadband: 0.02,
    touch_window: 3,
    // A remembered sprite is forgotten once everything learned about it has
    // faded nearer 0 than this (design v18 Â§5.6), and a remembered place
    // once it has faded below this (M2 design Â§7).
    forget_below: 0.01,
    // Remembered places (M2 design Â§7): a sprite remembers at most `held`,
    // and at most `per_kind` of one kind, so a big lake's shores can't
    // crowd out food; places of one kind `merge` tiles apart or fewer are
    // one place, so a pond is one place, not each of its tiles.
    remembered_places: (held: 8, per_kind: 3, merge: 5),

    // How long actions last (design Â§5.5): a rest in ticks, a retreat in
    // steps. An action still going at the timeout, in ticks, ends as timed out.
    actions: (rest_bout: 10, retreat_bout: 6, timeout: 60),
    // How sprites find their way (design Â§3.6â€“3.7). A flood is made again 8
    // ticks after the last, if the sprite hasn't moved sooner. It prices a
    // tile holding another sprite at `occupied_penalty` more, in terrain
    // units (a grass step is 10). After `replan_after` blocked ticks in a
    // row, a sprite looks for a way round the sprites in its way.
    movement: (flood_refresh: 8, occupied_penalty: 30, replan_after: 3),

    // The Cursor's touch (design v21 Â§4.6): the levels it raises, a starting
    // point for the lab's strength sweep; and the longest a pet's or hug's
    // feeling looks back for the sprite's latest try, in ticks (Â§5.6): two
    // seconds at 16Ã—. A shorter reach back than `touch_window` is taken as
    // that; a zap's or shock's always looks back `touch_window`. Then the
    // furthest the Cursor throws or shoves a thing of each size, in tiles
    // (design v25 Â§3.5.4): size stands in for weight, and sprites are large.
    cursor: (
        pet: 0.5,
        hug: 1.0,
        zap: (punishment: 0.5, pain: 0.3),
        shock: (punishment: 1.0, pain: 0.6),
        max_reach_back: 40,
        furthest: (small: 6, medium: 6, large: 5),
    ),
)
’³genomes/starter.ronÚ*Ğ// The starter genome (design Â§4.5, Â§5.8): what sprites without parents are
// made from. The world decides what happens to the body; these genes decide
// how that feels.
//
// Drives rise from a need and fall sharply when a one-shot action relieves
// it (a pulse-keyed Level emitter). The brain reads a need's fall as relief
// (design v16 Â§5.6), which teaches that the thing touched is good for it.
// Relief is gradual only where the relieving action is itself ongoing
// (resting, staying near others).
//
// The brain (design v16 Â§5.8): very basic instincts. They connect needs to
// actions, know the sprite's own kind, and fight or flee; they know nothing
// of food, water, toys or danger. The species is dropped into a world it
// doesn't know and learns it.
//
// The values are first cuts; slice 17 tunes them.
//
// A gene with `from` or `until` works only from that life stage on, or
// until it (M2 design Â§9.2): young, adult or old.
(
    format: 2,
    genes: [
        // Traits (design Â§4.8).
        Trait(trait: "speed", value: 7.0),
        Trait(trait: "sense_radius", value: 10.0),
        // It grows up at about an hour at 1x and grows old at about five, two
        // hours sooner or later from sprite to sprite (M2 design Â§9.3).
        Trait(trait: "grows_up", value: 4500.0),
        Trait(trait: "grows_old", value: 22500.0),

        // Hunger rises as energy falls below half, and drops at once on eating.
        Emitter(locus: Chem("energy"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "hunger"),
        Emitter(locus: Locus("ate"), mode: Level, gain: -0.5, chem: "hunger"),
        HalfLife(chem: "hunger", ticks: 2000),

        // Thirst, the same way with hydration and drinking.
        Emitter(locus: Chem("hydration"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "thirst"),
        Emitter(locus: Locus("drank"), mode: Level, gain: -0.5, chem: "thirst"),
        HalfLife(chem: "thirst", ticks: 2000),

        // Tiredness rises as stamina falls below half, and eases as rest restores it.
        Emitter(locus: Chem("stamina"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "tiredness"),
        Emitter(locus: Chem("stamina"), mode: Level, threshold: 0.6, gain: -0.1, chem: "tiredness"),

        // Boredom creeps up always; play relieves it at once, playing with
        // another sprite much less than kicking a ball.
        Emitter(locus: Locus("always"), mode: Level, gain: 0.0002, chem: "boredom"),
        Emitter(locus: Locus("played"), mode: Level, gain: -0.5, chem: "boredom"),
        Emitter(locus: Locus("played_social"), mode: Level, gain: -0.15, chem: "boredom"),

        // Loneliness rises with nobody near, and eases in company or at once in social play.
        Emitter(locus: Locus("nearby_sprites"), mode: Level, invert: true, threshold: 0.5, gain: 0.0005, chem: "loneliness"),
        Emitter(locus: Locus("nearby_sprites"), mode: Level, threshold: 0.2, gain: -0.1, chem: "loneliness"),
        Emitter(locus: Locus("played_social"), mode: Level, gain: -0.5, chem: "loneliness"),

        // Crowdedness rises in a crowd, and falls within a few ticks of leaving it.
        Emitter(locus: Locus("nearby_sprites"), mode: Level, threshold: 0.5, gain: 0.01, chem: "crowdedness"),
        Emitter(locus: Locus("nearby_sprites"), mode: Level, invert: true, threshold: 0.5, gain: -0.5, chem: "crowdedness"),

        // Arousal (M2 design Â§10) rises fast while it's fertile, and drops at
        // once when it lays an egg or fathers one, or within a few ticks of
        // its no longer being fertile, so others can read it as a sign of
        // fertility. The young are never fertile.
        Emitter(locus: Locus("fertile"), mode: Level, threshold: 0.5, gain: 0.01, chem: "arousal"),
        Emitter(locus: Locus("bred"), mode: Level, gain: -1.0, chem: "arousal"),
        Emitter(locus: Locus("fertile"), mode: Level, invert: true, threshold: 0.5, gain: -0.1, chem: "arousal"),
        HalfLife(chem: "arousal", ticks: 500),

        // Every sprite hatches male. Grown up, the feminiser builds while it
        // sees no female adult and falls fast while it sees one; past
        // physiology's level it turns female, for good (M2 design Â§10). A
        // male that sees no female for about 800 ticks turns.
        Emitter(locus: Locus("female_near"), mode: Level, invert: true, threshold: 0.5, gain: 0.003, chem: "feminiser", from: Adult),
        Emitter(locus: Locus("female_near"), mode: Level, gain: -0.01, chem: "feminiser"),
        HalfLife(chem: "feminiser", ticks: 600),

        // Longing builds while it sees no male adult and falls fast while it
        // sees one. A female can breed alone only once it's past physiology's
        // level (M2 design Â§10): about 1,100 ticks with no male in sight.
        Emitter(locus: Locus("male_near"), mode: Level, invert: true, threshold: 0.5, gain: 0.001, chem: "longing", from: Adult),
        Emitter(locus: Locus("male_near"), mode: Level, gain: -0.01, chem: "longing"),
        HalfLife(chem: "longing", ticks: 3000),

        // Pain comes with new injury, thorns and blows, and fades fast.
        Emitter(locus: Locus("pricked"), mode: Level, gain: 0.3, chem: "pain"),
        Emitter(locus: Locus("was_hit"), mode: Level, gain: 0.3, chem: "pain"),
        HalfLife(chem: "pain", ticks: 20),

        // Punishment. Rise emitters run after every Level emitter, in this
        // order, so injury â†’ pain â†’ punishment completes in one tick. Relief
        // needs no gene: the brain reads it from the needs themselves.
        Emitter(locus: Chem("injury"), mode: Rise, gain: 10.0, chem: "pain"),
        Emitter(locus: Chem("pain"), mode: Rise, gain: 1.0, chem: "punishment"),

        // Need makes a sprite restless (design v16 Â§4.5): the more pressing
        // hunger, thirst or boredom, the less sure its choices, so a sprite
        // that doesn't know where water is tries more things.
        Receptor(chem: "hunger", threshold: 0.2, gain: 1.0, target: "exploration_mod"),
        Receptor(chem: "thirst", threshold: 0.2, gain: 1.0, target: "exploration_mod"),
        Receptor(chem: "boredom", threshold: 0.2, gain: 0.5, target: "exploration_mod"),

        // Wariness (design v16 Â§4.5): pain feeds h0, which fades over a few
        // hundred ticks and lowers curiosity, so a run of hurts makes a sprite
        // shy of the unfamiliar for a while.
        Emitter(locus: Chem("pain"), mode: Level, threshold: 0.1, gain: 0.05, chem: "h0"),
        HalfLife(chem: "h0", ticks: 300),
        Receptor(chem: "h0", gain: -2.0, target: "curiosity_mod"),

        // How the brain works. Choices are fairly sure of themselves: with
        // no drive pressing a sprite wanders, and a drive of .5 wins most
        // choices. Habits are credited over a short trace, so a hurt is
        // blamed on what it did just before it (design v15 change 10). How
        // fast it learns worth and habits, and how curious it is, are
        // physiology's defaults (design v16, Appendix B).
        BrainParam(param: "trace_decay", value: 0.5),
        BrainParam(param: "tau_base", value: 0.1),
        BrainParam(param: "tau_att_base", value: 0.2),
        BrainParam(param: "switch_margin", value: 0.2),
        BrainParam(param: "attention_margin", value: 0.2),
        BrainParam(param: "salience_gain", value: 0.5),
        // The young are more curious: they try new things more readily; and
        // they learn faster (M2 design Â§9.5). Grown up, each has
        // physiology's default.
        BrainParam(param: "curiosity", value: 0.5, until: Adult),
        BrainParam(param: "plasticity", value: 1.5, until: Adult),

        // It knows its own kind: loneliness draws its eye to other sprites.
        // Nothing draws it to food, water or toys; it learns what they're for.
        AttentionInstinct(input: "loneliness", category: "sprite", weight: 1.0),
        // Being hit draws attention to sprites, which means the attacker.
        AttentionInstinct(input: "was_hit", category: "sprite", weight: 1.0),
        // Crowding draws attention to sprites.
        AttentionInstinct(input: "crowdedness", category: "sprite", weight: 1.0),
        // So does arousal, in a grown sprite (M2 design Â§10).
        AttentionInstinct(input: "arousal", category: "sprite", weight: 1.0),

        // Each need leads to its action, on whatever is attended: hunger to
        // eating, thirst to drinking. Trying it on the wrong thing does nothing.
        Instinct(inputs: [("hunger", false)], verb: Eat, weight: 1.0),
        Instinct(inputs: [("thirst", false)], verb: Drink, weight: 1.0),
        Instinct(inputs: [("tiredness", false)], verb: Rest, weight: 1.0),
        // Boredom leads to play; loneliness to going over to others, or
        // playing with them.
        Instinct(inputs: [("boredom", false)], verb: Play, weight: 1.0),
        Instinct(inputs: [("loneliness", false)], verb: Approach, weight: 0.8),
        Instinct(inputs: [("loneliness", false)], verb: Play, weight: 0.8),
        // Pain leads to backing away from whatever the sprite attends to.
        // Being hit, looking at the attacker, leads to hitting back, a little
        // more weakly than a hit's pain leads to backing away: a busy sprite
        // switches to whichever is stronger in it, so spawn variation makes
        // about one sprite in four one that hits back.
        Instinct(inputs: [("pain", false)], verb: Retreat, weight: 1.0),
        Instinct(inputs: [("was_hit", false), ("attended_sprite", false)], verb: Hit, weight: 0.56),
        // Crowding leads to backing away, and in a grown sprite sometimes to
        // hitting a neighbour: the deliberate mistake, which correcting
        // should cure. The young don't fight for room (M2 design Â§9.5).
        Instinct(inputs: [("crowdedness", false)], verb: Retreat, weight: 1.0),
        Instinct(inputs: [("crowdedness", false), ("attended_sprite", false)], verb: Hit, weight: 0.6, from: Adult),
        // A cornered sprite, looking at a sprite, turns on it.
        Instinct(inputs: [("cornered", false), ("attended_sprite", false)], verb: Hit, weight: 1.0),
        // Arousal leads to mating with the sprite attended to, if its body
        // language shows it's aroused too, and of the other sex; in a female
        // longing for a male, to laying an egg alone (M2 design Â§10).
        // Mating works only between a male and a female, both fertile.
        Instinct(inputs: [("arousal", false), ("target_arousal", false), ("target_other_sex", false)], verb: Mate, weight: 1.5),
        Instinct(inputs: [("arousal", false), ("female", false), ("longing", false)], verb: BreedAlone, weight: 1.0),
        // A mild habit of wandering, which any drive that has grown outweighs.
        Instinct(inputs: [("always", false)], verb: Wander, weight: 0.3),
    ],
)
’©names.ronÚ// Random names (design v28 Â§6.5): the screen offers one when the player
// names a sprite with `r`, joining a first syllable, sometimes a middle one,
// and a last. A name is at most 16 letters, so the longest first, middle and
// last together must fit.
(
    first: [
        "Mi", "To", "Ka", "Re", "Lu", "Sa", "Bo", "Ni", "Fe", "Ta",
        "Pi", "Ve", "Mo", "Ri", "Da", "Ze", "Wi", "Jo", "Ha", "Ou",
        "El", "An", "Ish", "Bri", "Tam",
    ],
    middle: [
        "ra", "be", "li", "no", "ta", "mi", "ko", "si", "ve", "lu",
    ],
    last: [
        "ra", "bek", "lo", "na", "ri", "mo", "sha", "kin", "pa", "lis",
        "tor", "wen", "di", "ko", "fa", "nel", "zu", "beth", "om", "y",
    ],
    // How often a name gets a middle syllable, from 0 to 1.
    middle_chance: 0.35,
