#!/usr/bin/env bash
# Terra Sprites: runs CI's checks on each commit being pushed, so a PR isn't
# opened red. Switched on per clone with `git config core.hooksPath .githooks`;
# Claude Code sessions switch it on themselves (.claude/settings.json).
#
# A commit whose tree scripts/check.sh already passed, on the Rust there is
# now, goes straight through. Any other is checked out on its own in a scratch
# worktree and checked with its own scripts/check.sh, as CI runs a commit's
# own workflow, so neither uncommitted changes nor untracked files (a
# forgotten module, another agent's test, an edit to check.sh itself) sway
# the result. That takes a few minutes. Tags and deletes are skipped.
set -euo pipefail
check="$(cd "$(dirname "$0")/.." && pwd)/scripts/check.sh"
cd "$(git rev-parse --show-toplevel)"
# A new Rust brings new lints, so a pass on an older one says nothing now.
rust=$(rustc -V)

zero=0000000000000000000000000000000000000000
stamps="$(git rev-parse --git-common-dir)/terra-checks-passed"
to_check=()
while read -r local_ref local_sha _remote_ref _remote_sha; do
    case "$local_ref" in refs/tags/*) continue ;; esac
    [ "$local_sha" = "$zero" ] && continue
    tree=$(git rev-parse "$local_sha^{tree}")
    [ -f "$stamps" ] && grep -qxF "$tree $rust" "$stamps" && continue
    to_check+=("$local_sha")
done

[ "${#to_check[@]}" = 0 ] && exit 0

scratch="$(git rev-parse --git-common-dir)/terra-check"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
cleanup() {
    git worktree remove --force "$scratch" >/dev/null 2>&1 || rm -rf "$scratch"
    git worktree prune
}
trap cleanup EXIT
for sha in "${to_check[@]}"; do
    echo "pre-push: running CI's checks on $(git rev-parse --short "$sha") on its own before pushing."
    echo "Run scripts/check.sh (or check.ps1) on a clean, committed tree first and this step is instant."
    cleanup
    git worktree add -q --detach "$scratch" "$sha"
    # A commit from before scripts/check.sh is checked with this folder's.
    (cd "$scratch" && if [ -f scripts/check.sh ]; then bash scripts/check.sh; else bash "$check"; fi)
done
