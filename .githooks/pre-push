#!/usr/bin/env bash
# Terra Sprites: runs CI's checks before a push, so a PR isn't opened red.
# Switched on per clone with `git config core.hooksPath .githooks`; Claude
# Code sessions switch it on themselves (.claude/settings.json).
#
# If scripts/check.sh or check.ps1 already passed on the commit being pushed,
# the push goes straight through. Otherwise it runs scripts/check.sh first,
# which takes a few minutes. Deleting a branch or pushing a tag skips it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
stamp=$(git rev-parse --git-path terra-checks-passed)
needs_check=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
    case "$local_ref" in refs/tags/*) continue ;; esac
    [ "$local_sha" = "$zero" ] && continue
    tree=$(git rev-parse "$local_sha^{tree}")
    [ -f "$stamp" ] && [ "$(tr -d '[:space:]' < "$stamp")" = "$tree" ] && continue
    if [ "$tree" != "$(git rev-parse 'HEAD^{tree}')" ]; then
        echo "pre-push: $local_ref isn't the branch checked out, so it can't be checked here; CI will check it."
        continue
    fi
    needs_check=1
done

[ "$needs_check" = 0 ] && exit 0

if ! git diff --quiet HEAD --; then
    echo "pre-push: there are changes not yet committed, so the checks wouldn't test what you're pushing."
    echo "Commit or stash them, then push again."
    exit 1
fi

echo "pre-push: running CI's checks on $(git rev-parse --short HEAD) before pushing (scripts/check.sh)."
echo "Run the checks yourself before pushing and this step is instant."
exec bash scripts/check.sh
