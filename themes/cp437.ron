// The default theme (design §6.2): CP437 glyphs, so any CP437 bitmap font or
// tileset can draw it. Every kind of thing has its own glyph; colour only
// decorates or marks state. Colours are the 16 terminal colours, by name:
// black, red, green, yellow, blue, magenta, cyan, gray, dark_gray, light_red,
// light_green, light_yellow, light_blue, light_magenta, light_cyan, white;
// or an exact colour, "#rrggbb". A name follows the player's terminal colours,
// so this theme uses exact ones only where no name fits: the panels' shades,
// the soft blue of what the pointer can be on, and motion's colours.
(
    tiles: {
        terrain(grass):         (glyph: '.', fg: green),
        terrain(dirt):          (glyph: ',', fg: yellow), // dark yellow: terminals have no brown
        terrain(sand):          (glyph: ':', fg: light_yellow),
        terrain(shallow_water): (glyph: '~', fg: cyan),
        terrain(deep_water):    (glyph: '≈', fg: blue),
        terrain(rock):          (glyph: '#', fg: gray),
        // Drawn over any item on the sprite's tile.
        sprite:                 (glyph: '☺', fg: white),
        // Selected, in reverse video, as the young and eggs are (design §6.2, #282).
        selected_sprite:        (glyph: '☻', fg: white, reversed: true),
        // The young are drawn small (M2 design §9.6). `•` is the berry.
        young_sprite:           (glyph: 'ö', fg: white),
        selected_young_sprite:  (glyph: 'ö', fg: white, reversed: true),
        // The Decision marker: where the selected sprite is heading. It flashes. CP437 has no `×`.
        decision_marker:        (glyph: 'X', fg: white),
        // Emotes take turns with a sprite's glyph (design §6.3): hurt by something.
        emote(hurt):            (glyph: '!', fg: red),
        // Petted or hugged, and zapped or shocked, by the Cursor (design v21
        // §6.3). A shock is a lightning bolt in a tileset; CP437 has none.
        emote(pleased):         (glyph: '♥', fg: light_magenta),
        emote(shocked):         (glyph: '‼', fg: yellow),
        // Gave up: failed, blocked or timed out; and resting, for as long as
        // the rest lasts (design §6.3). Not white: `?` in white is an object
        // no theme draws.
        emote(failed):          (glyph: '?', fg: light_yellow),
        emote(resting):         (glyph: 'z', fg: light_blue),
        // A dance and a call (M2 design §15.8), in arousal's colour.
        emote(dancing):         (glyph: '♫', fg: light_magenta),
        emote(calling):         (glyph: '♪', fg: light_magenta),
    },
    // A sprite's colour, by its strongest drive above .5, keyed by the
    // drive's name in the data pack (design §6.3). A drive with no colour
    // here, as from a mod, draws the sprite's own colour.
    drives: {
        "hunger":      yellow,
        "thirst":      cyan,
        "pain":        red,
        "tiredness":   blue,
        "boredom":     dark_gray,
        "loneliness":  magenta,
        "crowdedness": light_red,
        "arousal":     light_magenta,
        "anxiety":     light_green,
    },
    // Objects, by type name from the data pack's `objects.ron`, then visual
    // state. An object whose state isn't listed is drawn with its "default"
    // look, and one not listed at all as `?`.
    objects: {
        "berry_bush": {
            "seedling": (glyph: '\'', fg: green),
            "default":  (glyph: '♣', fg: green),                // bare
            "fruiting": (glyph: '♣', fg: red, bold: true),
        },
        "berry":     { "default": (glyph: '•', fg: red) },
        "thornbush": { "default": (glyph: '♠', fg: magenta) },
        "ball":      { "default": (glyph: '○', fg: white) },
        // An egg (M2 design §10.4). `○` is the ball.
        "egg":       { "default": (glyph: 'o', fg: light_yellow) },
    },
    // The 3×3 cursor (design §6.5). The arrows are named by the way they point.
    // Each mode's mark gives the cursor its colour: the arrows and status marks
    // take it too.
    // The Attention marker: the background of the tile the selected sprite
    // attends to (design §5.3).
    attention_marker: dark_gray,
    cursor: (
        arrows: (up: '↑', down: '↓', left: '←', right: '→'),
        // Following a sprite, the arrows are solid, clamping it (design v26 §6.2).
        followed_arrows: (up: '▲', down: '▼', left: '◄', right: '►'),
        // While sprites can see it, a frame of light in place of the arrows,
        // following or not (design v29 §6.5).
        visible_frame: (up: '═', down: '═', left: '║', right: '║'),
        status_marks: (
            idle: '·', // nothing to report
            sent: '+', // a click has just sent a command
            applied: '☼', // the world has just applied it
            rejected: '?', // or refused it
            // Grab mode shows what the Cursor has hold of (design v23 §6.5):
            // empty, grab and empty; holding or leading, release and the thing.
            grab: '↑',
            empty: '░',
            release: '↓',
        ),
        mode_marks: {
            select: (glyph: '♦', fg: white),
            // Train stands out on the grass the Cursor mostly sits on (design v22 §6.5).
            train:  (glyph: '±', fg: light_magenta),
            grab:   (glyph: '∩', fg: yellow),
        },
        // The leash, flashing from the Cursor to a sprite it leads, over empty
        // ground (design v23 §6.5).
        leash: (glyph: '·', fg: yellow),
        // The aim line, steady, while the player aims a throw or a shove: the
        // path, over empty ground, and where it would stop. `°`, not the
        // ball's `○` (design v25 §6.5).
        aim: (path: (glyph: '·', fg: yellow), end: (glyph: '°', fg: yellow)),
    ),
    // Past the wall (M2 design §11): the glass, one tile outside the map all
    // round, and the stars in space beyond it, drifting right to left, far to
    // nearest. What a theme leaves out of this section, it draws as the default
    // theme does.
    space: (
        glass: {
            horizontal:   (glyph: '═', fg: light_cyan),
            vertical:     (glyph: '║', fg: light_cyan),
            top_left:     (glyph: '╔', fg: light_cyan),
            top_right:    (glyph: '╗', fg: light_cyan),
            bottom_left:  (glyph: '╚', fg: light_cyan),
            bottom_right: (glyph: '╝', fg: light_cyan),
        },
        stars: {
            far:     (glyph: '·', fg: dark_gray),
            near:    (glyph: '∙', fg: gray),
            nearest: (glyph: '*', fg: white),
        },
    ),
    // The population graph (M2 design §14): the colour of each life stage
    // and of eggs, stacked from the bottom as eggs, young, adults and old; a
    // whole character of one, and its lower half, which shows the one below
    // over the one above, or over nothing at the top; each one's own
    // character, which a palette with no colour draws it in (design §6.2);
    // and the dotted line at the world's limit. What a theme leaves out of
    // this section, it draws as the default theme does.
    population: (
        stages: (young: light_green, adult: cyan, old: gray, egg: light_yellow),
        full: '█',
        half: '▄',
        bands: (young: '▓', adult: '█', old: '▒', egg: '░'),
        limit: (glyph: '·', fg: dark_gray),
    ),
    // The lineage colours (`b`, M2 design §17): the selected sprite's parents
    // and grandparents, its brothers and sisters, its young and theirs, and
    // every other sprite. The selected sprite keeps its own colour. Picked to
    // stand out on grass, dirt, sand and water alike. What a theme leaves out
    // of this section, it draws as the default theme does.
    lineage: (elders: light_blue, siblings: light_red, young: light_magenta, others: dark_gray),
    // The screen's text, by the job it does (design §6.2): headings, minor
    // text (a log line's tick, "and 3 more", a `·` between parts, a bar's
    // empty part, what a hint's key does), gains and losses, the key in each
    // hint, and what's chosen, such as the open tab. Each is a colour, `fg`,
    // with `bold` and `reversed`, any of them left out. Colour never carries
    // a meaning alone: the signs, arrows and capitals stay. What a theme
    // leaves out of this section, it styles as the default theme does.
    text: (
        heading:  (fg: light_cyan, bold: true),
        muted:    (fg: dark_gray),
        good:     (fg: light_green),
        bad:      (fg: light_red),
        key:      (bold: true),
        selected: (reversed: true),
        // A soft blue, quieter than the terminal's light blue, and one of
        // the 256 colours, so it's the same where exact ones aren't shown.
        spot:     (fg: "#87afd7"),
    ),
    // The panels beside and under the map (design §6.1): the inspector and
    // the event log sit on `shade`, a little lighter than the terminal's
    // black, and their title rows on `title`, lighter again, with no lines.
    // No named colour is that close to black, so they're exact. A theme
    // without this section draws a line between the panels and the map
    // instead, as the ASCII theme does.
    panels: (shade: "#181a22", title: "#282c3a"),
    // Motion's colours (design §6.9): a death's flash and the ash grey its
    // ghost fades to, a hatching's sparks, the trail's tint, the dark a
    // pop-up fades in from and out to, and the two shades each water drifts
    // between. Exact, since a fade blends exact colours; what a theme leaves
    // out of this section, it draws as the default theme does, but water it
    // draws in a colour of its own, which drifts from that colour.
    motion: (
        flash: "#d0d0d0",
        ash: "#5c5c5c",
        spark: "#ffe9a0",
        trail: "#2b3047",
        dark: "#0c0c0c",
        shallow_water: ("#3a96dd", "#62b4f0"),
        deep_water: ("#0037da", "#2f62f2"),
    ),
)
