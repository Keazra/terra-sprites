// The default theme (design §6.2): CP437 glyphs, so any CP437 bitmap font or
// tileset can draw it. Every kind of thing has its own glyph; colour only
// decorates or marks state. Colours are the 16 terminal colours, by name:
// black, red, green, yellow, blue, magenta, cyan, gray, dark_gray, light_red,
// light_green, light_yellow, light_blue, light_magenta, light_cyan, white.
(
    tiles: {
        terrain(grass):         (glyph: '.', fg: green),
        terrain(dirt):          (glyph: ',', fg: yellow), // dark yellow: terminals have no brown
        terrain(sand):          (glyph: ':', fg: light_yellow),
        terrain(shallow_water): (glyph: '~', fg: cyan),
        terrain(deep_water):    (glyph: '≈', fg: blue),
        terrain(rock):          (glyph: '#', fg: gray),
        // Drawn over any item on the sprite's tile.
        sprite:                 (glyph: '☺', fg: white),
        selected_sprite:        (glyph: '☻', fg: white),
        // The Decision marker: where the selected sprite is heading. It flashes. CP437 has no `×`.
        decision_marker:        (glyph: 'X', fg: white),
    },
    // Objects, by type name from the data pack's `objects.ron`, then visual
    // state. An object whose state isn't listed is drawn with its "default"
    // look, and one not listed at all as `?`.
    objects: {
        "berry_bush": {
            "seedling": (glyph: '\'', fg: green),
            "default":  (glyph: '♣', fg: green),                // bare
            "fruiting": (glyph: '♣', fg: red, bold: true),
        },
        "berry":     { "default": (glyph: '•', fg: red) },
        "thornbush": { "default": (glyph: '♠', fg: magenta) },
        "ball":      { "default": (glyph: '○', fg: white) },
    },
    // The 3×3 cursor (design §6.5). The arrows are named by the way they point.
    // Each mode's mark gives the cursor its colour: the arrows and status marks
    // take it too.
    // The Attention marker: the background of the tile the selected sprite
    // attends to (design §5.3).
    attention_marker: dark_gray,
    cursor: (
        arrows: (up: '↑', down: '↓', left: '←', right: '→'),
        status_marks: (
            idle: '·', // nothing to report
        ),
        mode_marks: {
            select: (glyph: '♦', fg: white),
        },
    ),
)
