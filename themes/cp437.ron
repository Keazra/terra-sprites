// The default theme (design §6.2): CP437 glyphs, so any CP437 bitmap font or
// tileset can draw it. Every kind of thing has its own glyph; colour only
// decorates or marks state. Colours are the 16 terminal colours, by name:
// black, red, green, yellow, blue, magenta, cyan, gray, dark_gray, light_red,
// light_green, light_yellow, light_blue, light_magenta, light_cyan, white.
(
    tiles: {
        terrain(grass):         (glyph: '.', fg: green),
        terrain(dirt):          (glyph: ',', fg: yellow), // dark yellow: terminals have no brown
        terrain(sand):          (glyph: ':', fg: light_yellow),
        terrain(shallow_water): (glyph: '~', fg: cyan),
        terrain(deep_water):    (glyph: '≈', fg: blue),
        terrain(rock):          (glyph: '#', fg: gray),
        // Drawn over any item on the sprite's tile.
        sprite:                 (glyph: '☺', fg: white),
        selected_sprite:        (glyph: '☻', fg: white),
        // The Decision marker: where the selected sprite is heading. It flashes. CP437 has no `×`.
        decision_marker:        (glyph: 'X', fg: white),
        // Emotes take turns with a sprite's glyph (design §6.3): hurt by something.
        emote(hurt):            (glyph: '!', fg: red),
        // Petted or hugged, and zapped or shocked, by the Cursor (design v21
        // §6.3). A shock is a lightning bolt in a tileset; CP437 has none.
        emote(pleased):         (glyph: '♥', fg: light_magenta),
        emote(shocked):         (glyph: '‼', fg: yellow),
        // Gave up: failed, blocked or timed out; and resting, for as long as
        // the rest lasts (design §6.3). Not white: `?` in white is an object
        // no theme draws.
        emote(failed):          (glyph: '?', fg: light_yellow),
        emote(resting):         (glyph: 'z', fg: light_blue),
    },
    // Objects, by type name from the data pack's `objects.ron`, then visual
    // state. An object whose state isn't listed is drawn with its "default"
    // look, and one not listed at all as `?`.
    // A sprite's colour, by its strongest drive above .5, keyed by the
    // drive's name in the data pack (design §6.3). A drive with no colour
    // here, as from a mod, draws the sprite's own colour.
    drives: {
        "hunger":      yellow,
        "thirst":      cyan,
        "pain":        red,
        "tiredness":   blue,
        "boredom":     dark_gray,
        "loneliness":  magenta,
        "crowdedness": light_red,
    },
    objects: {
        "berry_bush": {
            "seedling": (glyph: '\'', fg: green),
            "default":  (glyph: '♣', fg: green),                // bare
            "fruiting": (glyph: '♣', fg: red, bold: true),
        },
        "berry":     { "default": (glyph: '•', fg: red) },
        "thornbush": { "default": (glyph: '♠', fg: magenta) },
        "ball":      { "default": (glyph: '○', fg: white) },
    },
    // The 3×3 cursor (design §6.5). The arrows are named by the way they point.
    // Each mode's mark gives the cursor its colour: the arrows and status marks
    // take it too.
    // The Attention marker: the background of the tile the selected sprite
    // attends to (design §5.3).
    attention_marker: dark_gray,
    cursor: (
        arrows: (up: '↑', down: '↓', left: '←', right: '→'),
        // Following a sprite, the arrows are solid, clamping it (design v26 §6.2).
        followed_arrows: (up: '▲', down: '▼', left: '◄', right: '►'),
        status_marks: (
            idle: '·', // nothing to report
            sent: '+', // a click has just sent a command
            applied: '☼', // the world has just applied it
            rejected: '?', // or refused it
            // Grab mode shows what the Cursor has hold of (design v23 §6.5):
            // empty, grab and empty; holding or leading, release and the thing.
            grab: '↑',
            empty: '░',
            release: '↓',
        ),
        mode_marks: {
            select: (glyph: '♦', fg: white),
            // Train stands out on the grass the Cursor mostly sits on (design v22 §6.5).
            train:  (glyph: '±', fg: light_magenta),
            grab:   (glyph: '∩', fg: yellow),
        },
        // The leash, flashing from the Cursor to a sprite it leads, over empty
        // ground (design v23 §6.5).
        leash: (glyph: '·', fg: yellow),
        // The aim line, steady, while the player aims a throw or a shove: the
        // path, over empty ground, and where it would stop. `°`, not the
        // ball's `○` (design v25 §6.5).
        aim: (path: (glyph: '·', fg: yellow), end: (glyph: '°', fg: yellow)),
    ),
)
