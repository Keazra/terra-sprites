// The `--ascii` theme (design §6.2): the cp437 theme's meanings in plain ASCII
// glyphs. It changes only what themes cover (the map's tiles and the cursor);
// frames and text stay the same.
(
    tiles: {
        terrain(grass):         (glyph: '.', fg: green),
        terrain(dirt):          (glyph: ',', fg: yellow),
        terrain(sand):          (glyph: ':', fg: light_yellow),
        terrain(shallow_water): (glyph: '~', fg: cyan),
        terrain(deep_water):    (glyph: '=', fg: blue),
        terrain(rock):          (glyph: '#', fg: gray),
        sprite:                 (glyph: '@', fg: white),
        // `&` is already the berry bush, so the selected sprite is `@` in reverse video.
        selected_sprite:        (glyph: '@', fg: white, reversed: true),
        // Where the selected sprite is heading, in the detail view.
        destination:            (glyph: 'X', fg: white),
    },
    objects: {
        "berry_bush": {
            "seedling": (glyph: '\'', fg: green),
            "default":  (glyph: '&', fg: green),
            "fruiting": (glyph: '&', fg: red, bold: true),
        },
        "berry":     { "default": (glyph: '%', fg: red) },
        "thornbush": { "default": (glyph: '*', fg: magenta) },
        "ball":      { "default": (glyph: 'o', fg: white) },
    },
    cursor: (
        arrows: (up: '^', down: 'v', left: '<', right: '>'),
        status_marks: (idle: '-'),
        mode_marks: {
            select: (glyph: 'S', fg: white),
        },
    ),
)
