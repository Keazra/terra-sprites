// The starter genome (design §4.5, §5.8): what sprites without parents are
// made from. The world decides what happens to the body; these genes decide
// how that feels.
//
// Drives rise from a need and fall sharply when a one-shot action relieves
// it (a pulse-keyed Level emitter). The brain reads a need's fall as relief
// (design v16 §5.6), which teaches that the thing touched is good for it.
// Relief is gradual only where the relieving action is itself ongoing
// (resting, staying near others).
//
// The brain (design v16 §5.8): very basic instincts. They connect needs to
// actions, know the sprite's own kind, and fight or flee; they know nothing
// of food, water, toys or danger. The species is dropped into a world it
// doesn't know and learns it.
//
// The values are first cuts; slice 17 tunes them.
//
// A gene with `from` or `until` works only from that life stage on, or
// until it (M2 design §9.2): young, adult or old.
(
    format: 2,
    genes: [
        // Traits (design §4.8).
        Trait(trait: "speed", value: 7.0),
        Trait(trait: "sense_radius", value: 10.0),
        // It grows up at about an hour at 1x and grows old at about five, two
        // hours sooner or later from sprite to sprite (M2 design §9.3).
        Trait(trait: "grows_up", value: 4500.0),
        Trait(trait: "grows_old", value: 22500.0),

        // Hunger rises as energy falls below half, and drops at once on eating.
        Emitter(locus: Chem("energy"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "hunger"),
        Emitter(locus: Locus("ate"), mode: Level, gain: -0.5, chem: "hunger"),
        HalfLife(chem: "hunger", ticks: 2000),

        // Thirst, the same way with hydration and drinking.
        Emitter(locus: Chem("hydration"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "thirst"),
        Emitter(locus: Locus("drank"), mode: Level, gain: -0.5, chem: "thirst"),
        HalfLife(chem: "thirst", ticks: 2000),

        // Tiredness rises as stamina falls below half, and eases as rest restores it.
        Emitter(locus: Chem("stamina"), mode: Level, invert: true, threshold: 0.5, gain: 0.004, chem: "tiredness"),
        Emitter(locus: Chem("stamina"), mode: Level, threshold: 0.6, gain: -0.1, chem: "tiredness"),

        // Boredom creeps up always; play relieves it at once, playing with
        // another sprite much less than kicking a ball.
        Emitter(locus: Locus("always"), mode: Level, gain: 0.0002, chem: "boredom"),
        Emitter(locus: Locus("played"), mode: Level, gain: -0.5, chem: "boredom"),
        Emitter(locus: Locus("played_social"), mode: Level, gain: -0.15, chem: "boredom"),

        // Loneliness rises with nobody near, and eases in company or at once in social play.
        Emitter(locus: Locus("nearby_sprites"), mode: Level, invert: true, threshold: 0.5, gain: 0.0005, chem: "loneliness"),
        Emitter(locus: Locus("nearby_sprites"), mode: Level, threshold: 0.2, gain: -0.1, chem: "loneliness"),
        Emitter(locus: Locus("played_social"), mode: Level, gain: -0.5, chem: "loneliness"),

        // Crowdedness rises in a crowd, and falls within a few ticks of leaving it.
        Emitter(locus: Locus("nearby_sprites"), mode: Level, threshold: 0.5, gain: 0.01, chem: "crowdedness"),
        Emitter(locus: Locus("nearby_sprites"), mode: Level, invert: true, threshold: 0.5, gain: -0.5, chem: "crowdedness"),

        // Arousal (M2 design §10) rises fast while it's fertile, and drops at
        // once when it lays an egg or fathers one, or within a few ticks of
        // its no longer being fertile, so others can read it as a sign of
        // fertility. The young are never fertile.
        Emitter(locus: Locus("fertile"), mode: Level, threshold: 0.5, gain: 0.01, chem: "arousal"),
        Emitter(locus: Locus("bred"), mode: Level, gain: -1.0, chem: "arousal"),
        Emitter(locus: Locus("fertile"), mode: Level, invert: true, threshold: 0.5, gain: -0.1, chem: "arousal"),
        HalfLife(chem: "arousal", ticks: 500),

        // Every sprite hatches male. Grown up, the feminiser builds while it
        // sees no female adult and falls fast while it sees one; past
        // physiology's level it turns female, for good (M2 design §10). A
        // male that sees no female for about 800 ticks turns.
        Emitter(locus: Locus("female_near"), mode: Level, invert: true, threshold: 0.5, gain: 0.003, chem: "feminiser", from: Adult),
        Emitter(locus: Locus("female_near"), mode: Level, gain: -0.01, chem: "feminiser"),
        HalfLife(chem: "feminiser", ticks: 600),

        // Longing builds while it sees or hears no male adult and falls fast
        // while it does: it's whether a female wants to breed alone, which
        // her body allows only after about an hour with no male seen or
        // heard (M2 design §10, §15.7). It builds over about that hour, so
        // she calls for a mate before she tries.
        Emitter(locus: Locus("male_near"), mode: Level, invert: true, threshold: 0.5, gain: 0.0002, chem: "longing", from: Adult),
        Emitter(locus: Locus("male_near"), mode: Level, gain: -0.01, chem: "longing"),
        HalfLife(chem: "longing", ticks: 3000),

        // Receptivity rises a little when it's danced for, much more when it
        // dances back, and fades within about ten minutes; it drops at once
        // when it breeds. Two or three dances each make a female receptive
        // enough to mate, but being danced for alone never does (M2 design
        // §15.3).
        Emitter(locus: Locus("courted"), mode: Level, gain: 0.04, chem: "receptivity"),
        Emitter(locus: Locus("danced"), mode: Level, gain: 0.2, chem: "receptivity"),
        Emitter(locus: Locus("bred"), mode: Level, gain: -1.0, chem: "receptivity"),
        HalfLife(chem: "receptivity", ticks: 600),
        // A dance leaves h1, so a male waits a little before he dances
        // again, and being danced for leaves h2, so for a minute or so after
        // a sprite would dance back.
        Emitter(locus: Locus("danced"), mode: Level, gain: 1.0, chem: "h1"),
        HalfLife(chem: "h1", ticks: 40),
        Emitter(locus: Locus("courted"), mode: Level, gain: 1.0, chem: "h2"),
        HalfLife(chem: "h2", ticks: 60),

        // Losing a partner brings grief, which holds arousal down for about
        // 1,500 ticks (M2 design §15.4).
        Emitter(locus: Locus("lost_partner"), mode: Level, gain: 1.0, chem: "grief"),
        Emitter(locus: Chem("grief"), mode: Level, threshold: 0.3, gain: -0.2, chem: "arousal"),
        HalfLife(chem: "grief", ticks: 860),

        // Anxiety holds a family together (M2 design §15.6). A parent's
        // rises while its egg is out of sight, four times as fast if it left
        // the egg with no other parent by it. It rises while its young or its
        // partner are out of sight, and faster in a young sprite while no
        // parent is in sight. Finding the one it missed drops it at once,
        // and it fades within a few minutes. Hunger and thirst come first:
        // past 0.4, they drain it.
        Emitter(locus: Locus("egg_away"), mode: Level, gain: 0.01, chem: "anxiety"),
        Emitter(locus: Locus("egg_alone"), mode: Level, gain: 0.03, chem: "anxiety"),
        Emitter(locus: Locus("young_away"), mode: Level, gain: 0.02, chem: "anxiety"),
        Emitter(locus: Locus("parent_away"), mode: Level, gain: 0.03, chem: "anxiety"),
        Emitter(locus: Locus("partner_away"), mode: Level, gain: 0.02, chem: "anxiety"),
        Emitter(locus: Locus("found_family"), mode: Level, gain: -0.5, chem: "anxiety"),
        HalfLife(chem: "anxiety", ticks: 300),
        Emitter(locus: Chem("hunger"), mode: Level, threshold: 0.4, gain: -0.05, chem: "anxiety"),
        Emitter(locus: Chem("thirst"), mode: Level, threshold: 0.4, gain: -0.05, chem: "anxiety"),

        // Pain comes with new injury, thorns and blows, and fades fast.
        Emitter(locus: Locus("pricked"), mode: Level, gain: 0.3, chem: "pain"),
        Emitter(locus: Locus("was_hit"), mode: Level, gain: 0.3, chem: "pain"),
        HalfLife(chem: "pain", ticks: 20),

        // Punishment. Rise emitters run after every Level emitter, in this
        // order, so injury → pain → punishment completes in one tick. Relief
        // needs no gene: the brain reads it from the needs themselves.
        Emitter(locus: Chem("injury"), mode: Rise, gain: 10.0, chem: "pain"),
        Emitter(locus: Chem("pain"), mode: Rise, gain: 1.0, chem: "punishment"),

        // Need makes a sprite restless (design v16 §4.5): the more pressing
        // hunger, thirst or boredom, the less sure its choices, so a sprite
        // that doesn't know where water is tries more things.
        Receptor(chem: "hunger", threshold: 0.2, gain: 1.0, target: "exploration_mod"),
        Receptor(chem: "thirst", threshold: 0.2, gain: 1.0, target: "exploration_mod"),
        Receptor(chem: "boredom", threshold: 0.2, gain: 0.5, target: "exploration_mod"),

        // Wariness (design v16 §4.5): pain feeds h0, which fades over a few
        // hundred ticks and lowers curiosity, so a run of hurts makes a sprite
        // shy of the unfamiliar for a while.
        Emitter(locus: Chem("pain"), mode: Level, threshold: 0.1, gain: 0.05, chem: "h0"),
        HalfLife(chem: "h0", ticks: 300),
        Receptor(chem: "h0", gain: -2.0, target: "curiosity_mod"),

        // How the brain works. Choices are fairly sure of themselves: with
        // no drive pressing a sprite wanders, and a drive of .5 wins most
        // choices. Habits are credited over a short trace, so a hurt is
        // blamed on what it did just before it (design v15 change 10). How
        // fast it learns worth and habits, and how curious it is, are
        // physiology's defaults (design v16, Appendix B).
        BrainParam(param: "trace_decay", value: 0.5),
        BrainParam(param: "tau_base", value: 0.1),
        BrainParam(param: "tau_att_base", value: 0.2),
        BrainParam(param: "switch_margin", value: 0.2),
        BrainParam(param: "attention_margin", value: 0.2),
        BrainParam(param: "salience_gain", value: 0.5),
        // The young are more curious: they try new things more readily; and
        // they learn faster (M2 design §9.5). Grown up, each has
        // physiology's default.
        BrainParam(param: "curiosity", value: 0.5, until: Adult),
        BrainParam(param: "plasticity", value: 1.5, until: Adult),
        // Every sprite learns by watching, the young most: they take on half
        // the way to what one they watch knows of what it uses and of what
        // happens to it; grown up, a quarter (M2 design §18.1).
        BrainParam(param: "watch_rate", value: 0.5, until: Adult),
        BrainParam(param: "watch_rate", value: 0.25, from: Adult),

        // It knows its own kind: loneliness draws its eye to other sprites.
        // Nothing draws it to food, water or toys; it learns what they're for.
        AttentionInstinct(input: "loneliness", category: "sprite", weight: 1.0),
        // Being hit draws attention to sprites, which means the attacker.
        AttentionInstinct(input: "was_hit", category: "sprite", weight: 1.0),
        // Crowding draws attention to sprites.
        AttentionInstinct(input: "crowdedness", category: "sprite", weight: 1.0),
        // So does arousal, in a grown sprite (M2 design §10), but not to its
        // kin (§15.5).
        AttentionInstinct(input: "arousal", category: "sprite", weight: 1.0),
        AttentionInstinct(input: "arousal", category: "sprite", whom: Kin, weight: -1.0),
        // Missing one of its family draws its eye to that one: its young,
        // its parents while it's young, its partner, or its egg; and anxiety
        // draws it to all its family (M2 design §15.6).
        AttentionInstinct(input: "young_away", category: "sprite", whom: Young, weight: 1.0),
        AttentionInstinct(input: "parent_away", category: "sprite", whom: Parent, weight: 1.0),
        AttentionInstinct(input: "partner_away", category: "sprite", whom: Partner, weight: 1.0),
        AttentionInstinct(input: "anxiety", category: "sprite", whom: Family, weight: 1.0),
        AttentionInstinct(input: "anxiety", category: "egg", whom: Family, weight: 1.0),
        AttentionInstinct(input: "egg_away", category: "egg", whom: Family, weight: 1.0),
        // The young watch the grown-ups, and their parents as much again,
        // and a parent doing something that would show them a lesson they
        // haven't learned draws their eye strongly (M2 design §18.1). The
        // weights are first guesses, tuned against §18.6.
        AttentionInstinct(input: "always", category: "sprite", whom: Grown, weight: 0.3, until: Adult),
        AttentionInstinct(input: "always", category: "sprite", whom: Parent, weight: 0.3, until: Adult),
        AttentionInstinct(input: "always", category: "sprite", whom: Showing, weight: 1.0, until: Adult),

        // Each need leads to its action, on whatever is attended: hunger to
        // eating, thirst to drinking. Trying it on the wrong thing does nothing.
        Instinct(inputs: [("hunger", false)], verb: Eat, weight: 1.0),
        Instinct(inputs: [("thirst", false)], verb: Drink, weight: 1.0),
        Instinct(inputs: [("tiredness", false)], verb: Rest, weight: 1.0),
        // Boredom leads to play; loneliness to going over to others, or
        // playing with them.
        Instinct(inputs: [("boredom", false)], verb: Play, weight: 1.0),
        Instinct(inputs: [("loneliness", false)], verb: Approach, weight: 0.8),
        Instinct(inputs: [("loneliness", false)], verb: Play, weight: 0.8),
        // Pain leads to backing away from whatever the sprite attends to.
        // Being hit, looking at the attacker, leads to hitting back, a little
        // more weakly than a hit's pain leads to backing away: a busy sprite
        // switches to whichever is stronger in it, so spawn variation makes
        // about one sprite in four one that hits back.
        Instinct(inputs: [("pain", false)], verb: Retreat, weight: 1.0),
        Instinct(inputs: [("was_hit", false), ("attended_sprite", false)], verb: Hit, weight: 0.56),
        // Crowding leads to backing away, and in a grown sprite sometimes to
        // hitting a neighbour: the deliberate mistake, which correcting
        // should cure. The young don't fight for room (M2 design §9.5).
        Instinct(inputs: [("crowdedness", false)], verb: Retreat, weight: 1.0),
        Instinct(inputs: [("crowdedness", false), ("attended_sprite", false)], verb: Hit, weight: 0.6, from: Adult),
        // A cornered sprite, looking at a sprite, turns on it. Each is held
        // back from hitting its family, though a family together is a crowd
        // (M2 design §15.6).
        Instinct(inputs: [("cornered", false), ("attended_sprite", false)], verb: Hit, weight: 1.0),
        Instinct(inputs: [("target_family", false)], verb: Hit, weight: -1.0),
        // Calling costs energy, so a sprite shies from it, unless it's
        // aroused with no adult of the other sex seen or heard (M2 design
        // §15.1), or anxious, to keep in touch with its family (§15.6).
        Instinct(inputs: [("always", false)], verb: Call, weight: -0.5),
        Instinct(inputs: [("arousal", false), ("female", true), ("female_near", true)], verb: Call, weight: 1.0),
        Instinct(inputs: [("arousal", false), ("female", false), ("male_near", true)], verb: Call, weight: 1.0),
        Instinct(inputs: [("anxiety", false)], verb: Call, weight: 0.8),
        // An anxious sprite goes to its family, in sight, heard calling, or
        // its egg where it last saw it (§15.6).
        Instinct(inputs: [("anxiety", false), ("target_family", false)], verb: Approach, weight: 1.0),
        // An aroused sprite plays with a stranger of the other sex, in sight
        // or heard calling, so they get to know each other (§15.2), and
        // goes to its partner.
        Instinct(inputs: [("arousal", false), ("target_other_sex", false), ("target_familiar", true)], verb: Play, weight: 1.0),
        Instinct(inputs: [("arousal", false), ("target_partner", false)], verb: Approach, weight: 1.0),
        // He dances, she chooses (§15.3). An aroused sprite dances for an
        // aroused one it knows well, but a female only once she's danced
        // for, and a male waits a little between dances and stops once she
        // looks receptive. One lately danced for by a sprite it knows dances
        // back, the more readily the healthier it looks. Neither dances for its own sex nor its kin, and one with a
        // partner dances only for its partner (§15.4, §15.5). A link is at
        // most 1 either way (M1 design §5.4), so each of these can cancel
        // the others.
        Instinct(inputs: [("arousal", false), ("target_arousal", false), ("target_familiar", false)], verb: Court, weight: 1.0),
        Instinct(inputs: [("female", false), ("h2", true)], verb: Court, weight: -1.0),
        Instinct(inputs: [("female", true), ("h1", false)], verb: Court, weight: -1.0),
        Instinct(inputs: [("h2", false), ("target_familiar", false), ("target_condition", false)], verb: Court, weight: 1.0),
        Instinct(inputs: [("target_other_sex", true)], verb: Court, weight: -1.0),
        Instinct(inputs: [("target_kin", false)], verb: Court, weight: -1.0),
        Instinct(inputs: [("female", true), ("target_receptivity", false)], verb: Court, weight: -1.0),
        Instinct(inputs: [("paired", false), ("target_partner", true)], verb: Court, weight: -1.0),
        // Arousal leads to mating with the sprite attended to, if its body
        // language shows it's aroused too, and of the other sex, but not
        // while she isn't receptive, and never readily with kin (M2 design
        // §10, §15.3, §15.5). In a female longing for a male, it leads to
        // laying an egg alone. Mating works only between a male and a
        // female, both fertile, and she receptive enough.
        Instinct(inputs: [("arousal", false), ("target_arousal", false), ("target_other_sex", false)], verb: Mate, weight: 1.0),
        Instinct(inputs: [("female", true), ("target_receptivity", true)], verb: Mate, weight: -1.0),
        Instinct(inputs: [("female", false), ("receptivity", true)], verb: Mate, weight: -1.0),
        Instinct(inputs: [("target_kin", false)], verb: Mate, weight: -1.0),
        Instinct(inputs: [("arousal", false), ("female", false), ("longing", false)], verb: BreedAlone, weight: 1.0),
        // A mild habit of wandering, which any drive that has grown outweighs.
        Instinct(inputs: [("always", false)], verb: Wander, weight: 0.3),
    ],
)
