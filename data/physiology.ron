// Physiology (design §4.4, Appendix B): the body's fixed rules, which genes
// can't change. Levels are fractions of full, from 0 to 1; rates are per tick.
//
// The starting values aim for these timescales, for a sprite at rest: full
// hydration lasts about 3,000 ticks and full energy about 6,000; once either
// runs out, injury kills in about 1,000 more; an old sprite whose body has
// given out dies within about 2,000. Slice 17 tunes them.
(
    // What a newborn's physical chemicals start at. Injury and gut contents start at 0.
    newborn: (energy: 1.0, hydration: 1.0, stamina: 1.0),
    // The first population, placed by world generation, starts with its energy
    // and its hydration each drawn between these fractions of the newborn level.
    first_population: (0.6, 1.0),

    metabolism: (
        basal: 0.0001,              // energy per tick
        per_sense_tile: 0.0000067,  // energy per tick, per tile of sense radius
        per_step: 0.0002,           // energy per step at speed 8; scales with (speed / 8)²
    ),
    // Gut contents moved into the body per tick: food into energy, water into hydration.
    digestion: (food: 0.001, water: 0.002),
    hydration_loss: 0.00033,
    stamina: (per_step: 0.002, idle: 0.0005, resting: 0.002),
    healing: 0.0001,  // injury healed per tick
    // Injury per tick while energy is at 0, while hydration is at 0, and once
    // an old body has given out.
    injury: (starvation: 0.0011, dehydration: 0.0011, old_age: 0.0006),
    // Growing up and growing old (M2 design §9). First guesses, tuned in play
    // and in the viability run with A4 holding.
    ageing: (
        // A newborn walks at this share of its speed, rising steadily to all
        // of it when it grows up.
        young_speed: 0.67,
        // The energy growing up takes, spread evenly over childhood, so a
        // sprite that grows up sooner is a hungrier child.
        growth: 0.3,
        // Energy per tick, all its life, for every 10,000 ticks of
        // `grows_old`, for a pack that wants a later old age to cost
        // something. 0 here, the owner's call (M2 design §12): lives end as
        // the body and brain fail, not by an energy charge, so they may
        // grow long.
        upkeep: 0.0,
        // Wear from a hard life, which never heals: per tick while energy
        // is below `low` (starving) or hydration is (parched), and per tick
        // for each unit of injury. The most worn sprite grows old `sooner`
        // (a share of the age its genes say), and its genes then decay
        // `wear_speedup` times as fast.
        wear: (low: 0.25, starving: 0.0002, parched: 0.0002, injured: 0.001),
        wear_speedup: 3.0,
        sooner: 0.33,
        // Old, its repair no longer keeps up: damage lands on random genes,
        // `hit` health at a time (half that on an instinct), so its genes
        // fall to `gives_out` on average in `ticks` for an unworn sprite.
        // There its body gives out and old age harms it, so that old age
        // lasts about an hour at 1x (M2 design §2).
        decay: (ticks: 3600, hit: 0.01, gives_out: 0.5),
        // While its injury is above `above`, each tick a random gene may be
        // scarred, losing `hit` health for good, at any age.
        scar: (above: 0.5, chance: 0.002, hit: 0.05),
    ),
    // Having young (M2 design §10). An egg hatches after `hatches` ticks (10
    // minutes at 1x). It costs its parents `cost` energy in all, split
    // between them, or all of it for one breeding alone. An adult is fertile
    // while its energy and hydration are both above `fed`, and `rest` ticks
    // or more after its last egg. Every sprite hatches male; an adult male
    // turns female for good once its `feminiser` hormone is above
    // `turns_female`. A female can breed alone only once her `longing`
    // hormone has reached `breeds_alone`. The need `drive` drives breeding:
    // whatever the genes, it works only between adults, and what easing it
    // teaches is only about the partner (M2 design §5). A pair's egg takes
    // its genes from one parent in stretches: at each gene it switches to
    // the other with the chance `crossover` (M2 design §12).
    breeding: (
        hatches: 750,
        cost: 0.3,
        fed: 0.5,
        rest: 1500,
        turns_female: 0.8,
        breeds_alone: 0.5,
        drive: "arousal",
        crossover: 0.1,
    ),
    // Each cause-of-death tally halves every this many ticks (design §4.10).
    cause_fade: 350,

    // The range each trait gene is clamped to (design §4.8).
    traits: (
        speed: (4.0, 12.0),
        sense_radius: (6.0, 14.0),
        // The ages a sprite grows old and grows up at (M2 design §9.3).
        grows_old: (6000.0, 60000.0),
        grows_up: (1500.0, 13500.0),
    ),
    // Each brain parameter's range, which a `BrainParam` gene is clamped to,
    // and the value a genome with no gene for it gets (design §5.7, Appendix B).
    brain: {
        "learning_rate":     (range: (0.001, 0.5),   default: 0.05),
        "trace_decay":       (range: (0.5, 0.99),    default: 0.9),
        "relax_rate":        (range: (0.0, 0.01),    default: 0.001),
        "consolidate_rate":  (range: (0.0, 0.001),   default: 0.0001),
        "tau_base":          (range: (0.05, 2.0),    default: 0.2),
        "tau_att_base":      (range: (0.05, 2.0),    default: 0.2),
        "switch_margin":     (range: (0.0, 1.0),     default: 0.2),
        "attention_margin":  (range: (0.0, 1.0),     default: 0.2),
        "salience_gain":     (range: (0.0, 2.0),     default: 0.5),
        "pool_size":         (range: (0.0, 64.0),    default: 32.0),
        "max_arity":         (range: (1.0, 3.0),     default: 3.0),
        "recruit_threshold": (range: (0.0, 1.0),     default: 0.3),
        "novelty_threshold": (range: (0.0, 1.0),     default: 0.5),
        "forget_ticks":      (range: (100.0, 100000.0), default: 5000.0),
        // Learning (design v16 §5.6). Since v16 learning_rate, relax_rate and
        // consolidate_rate do nothing, nor do pool_size to forget_ticks while
        // the recruitable pool is on hold; genomes may still carry them.
        // Lessons fade slowly (design §5.6): a good one by half in about
        // 28,000 ticks, 6 hours at 1x, an average life; a bad one, and fear,
        // in about 110,000, so in effect it lasts a life.
        "worth_rate_good":   (range: (0.0, 1.0),     default: 0.5),
        "worth_rate_bad":    (range: (0.0, 1.0),     default: 0.8),
        "worth_fade_good":   (range: (0.0, 0.01),    default: 0.000025),
        "worth_fade_bad":    (range: (0.0, 0.01),    default: 0.00000625),
        "habit_rate":        (range: (0.0, 1.0),     default: 0.3),
        "habit_fade":        (range: (0.0, 0.01),    default: 0.000025),
        "value_gain":        (range: (0.0, 2.0),     default: 1.0),
        "curiosity":         (range: (0.0, 1.0),     default: 0.3),
        "familiarity_rate":  (range: (0.0, 0.05),    default: 0.002),
        "disappointment":    (range: (0.0, 1.0),     default: 0.3),
        // Individuals and fear (design v18 §5.3, §5.5, §5.6), from slice 9c's
        // prototype (#62).
        "individual_rate_good": (range: (0.0, 1.0),  default: 0.8),
        "individual_rate_bad":  (range: (0.0, 1.0),  default: 0.9),
        "fear_rate":         (range: (0.0, 1.0),     default: 1.0),
        "fear_fade":         (range: (0.0, 0.01),    default: 0.00000625),
        "generalise":        (range: (2.0, 10.0),    default: 3.0),
        "vigilance":         (range: (0.0, 2.0),     default: 0.8),
        "flight":            (range: (0.0, 2.0),     default: 0.8),
        "fear_reach":        (range: (0.1, 1.0),     default: 0.5),
        // Category summaries (design v19 §5.6), at generalise's value.
        "generalise_types":  (range: (2.0, 10.0),    default: 3.0),
        // A pressing first-order need quiets what a sprite merely likes, by
        // at most this much, never all of it; and bad habits fade as slowly
        // as bad things (design v21 §5.6).
        "quieting":          (range: (0.0, 1.0),     default: 0.8),
        "habit_fade_bad":    (range: (0.0, 0.01),    default: 0.00000625),
        // Fear of the Cursor wears off while it stays near and does nothing,
        // fastest on the sprite's own tile (design v29 §5.6): a sprite comes
        // to see it can't do anything about it. A first guess, tuned in play.
        "cursor_calming":    (range: (0.0, 0.1),     default: 0.01),
        // How much a remembered place fades each tick (M2 design §7):
        // by half in about 3,500 ticks. A place can change, as a bush dies,
        // so it fades faster than a lesson.
        "place_fade":        (range: (0.0, 0.01),    default: 0.0002),
        // Every learning rate is multiplied by it (M2 design §9.5): the
        // starter genome's young learn faster.
        "plasticity":        (range: (0.25, 4.0),    default: 1.0),
        // Taught habits: 3x habit_rate, fading as slowly as a bad lesson
        // (design §5.6, #187).
        "taught_rate":       (range: (0.0, 1.0),     default: 0.9),
        "taught_fade":       (range: (0.0, 0.01),    default: 0.00000625),
    },
    // The range of each receptor target in `loci.ron`. Each rests at 1.0 when
    // no receptor writes it.
    receptor_targets: {
        "learning_rate_mod": (0.5, 2.0),
        "exploration_mod": (0.25, 4.0),
        "curiosity_mod": (0.0, 2.0),
    },

    // The `nearby_sprites` body sensor counts the other sprites within
    // `radius` tiles, in any direction, and reads 1 at `full` of them.
    nearby_sprites: (radius: 3, full: 4),

    // Spawn variation (design §4.9): each gene value is multiplied by a factor
    // drawn between 1 − this and 1 + this.
    spawn_variation: 0.1,
    // A trait named here varies by its own share instead (M2 design §9.3):
    // the age a sprite grows old at, by up to 40%, so that lives last from
    // about 4 hours to about 8 at 1x (M2 design §2).
    trait_variation: { "grows_old": 0.4 },
    // Copying errors (M2 design §12): when an egg is laid, each gene value
    // has `chance` of changing, so about one hatchling in two has a change.
    // Rare and mostly large, so they show: a `large.share` of the changes
    // are a factor from 1 / `large.most` to `large.most`, the rest small, a
    // factor between 1 − `small` and 1 + `small`. First guesses.
    mutation: (chance: 0.01, small: 0.2, large: (share: 0.75, most: 2.0)),
    // Hidden flaws (M2 design §12): a sprite has two copies of each gene
    // that can weaken, one from each parent, and one sound copy is enough.
    // As an egg's genes are copied, each sound copy gets a flaw with the
    // chance `arise`, so about one egg in two has a new one. A sprite made
    // from the starter genome carries a flaw in one copy of each such gene
    // with the chance `founders`: about three each. A gene with both copies
    // flawed is broken: it's born with `health`, and counts as `wear` of
    // wear, bringing old age sooner (M2 design §9.4). First guesses.
    flaws: (arise: 0.007, founders: 0.06, health: 0.5, wear: 0.05),

    // A learned value this far from 0 is a lesson, which the event log
    // announces once (design v16 §5.6).
    lesson_threshold: 0.5,

    // Learning (design v16 §5.6): the least fall of a need in a tick that
    // counts as relief, and how many ticks after a try the thing tried on
    // is still the thing a feeling is about.
    relief_deadband: 0.02,
    touch_window: 3,
    // A remembered sprite is forgotten once everything learned about it has
    // faded nearer 0 than this (design v18 §5.6), and a remembered place
    // once it has faded below this (M2 design §7).
    forget_below: 0.01,
    // Remembered places (M2 design §7): a sprite remembers at most `held`,
    // and at most `per_kind` of one kind, so a big lake's shores can't
    // crowd out food; places of one kind `merge` tiles apart or fewer are
    // one place, so a pond is one place, not each of its tiles.
    remembered_places: (held: 8, per_kind: 3, merge: 5),

    // How long actions last (design §5.5): a rest in ticks, a retreat in
    // steps. An action still going at the timeout, in ticks, ends as timed out.
    actions: (rest_bout: 10, retreat_bout: 6, timeout: 60),
    // How sprites find their way (design §3.6–3.7). A flood is made again 8
    // ticks after the last, if the sprite hasn't moved sooner. It prices a
    // tile holding another sprite at `occupied_penalty` more, in terrain
    // units (a grass step is 10). After `replan_after` blocked ticks in a
    // row, a sprite looks for a way round the sprites in its way.
    movement: (flood_refresh: 8, occupied_penalty: 30, replan_after: 3),

    // The Cursor's touch (design v21 §4.6): the levels it raises, a starting
    // point for the lab's strength sweep; and the longest a pet's or hug's
    // feeling looks back for the sprite's latest try, in ticks (§5.6): two
    // seconds at 16×. A shorter reach back than `touch_window` is taken as
    // that; a zap's or shock's always looks back `touch_window`. Then the
    // furthest the Cursor throws or shoves a thing of each size, in tiles
    // (design v25 §3.5.4): size stands in for weight, and sprites are large.
    cursor: (
        pet: 0.5,
        hug: 1.0,
        zap: (punishment: 0.5, pain: 0.3),
        shock: (punishment: 1.0, pain: 0.6),
        max_reach_back: 40,
        furthest: (small: 6, medium: 6, large: 5),
    ),
)
