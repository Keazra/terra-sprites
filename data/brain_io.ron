// The brain's State inputs (design §5.2, Appendix A): what a sprite's brain
// feels, each reading a drive, a hormone, a body sensor or a pulse. IDs are
// stable and append-only: never renumber or reuse one. An input that reads
// `Target(...)` reads the same in the body of the sprite attended to, its body
// language, and one that reads `Differs(...)` how far that differs from the
// sprite's own (M2 design §10). `Familiar`, `Partner` and `Kin` read what the
// sprite knows of the one it attends to (M2 design §15), and `Family` whether
// what it attends to is its family (§15.6).
//
// Not brain inputs: physical chemicals (the brain feels the body only through
// drives), reward and punishment (learning signals), the `moving` and
// `resting` sensors (as inputs they'd loop an action back into itself) and
// receptor targets. The Target inputs are one for each category in
// categories.ron, attended_<category>, then target_distance (42) and
// target_adjacent (43), and IDs 36 to 63 are kept for them, so State inputs
// carry on from 64.
(
inputs: [
    (id: 1,  name: "hunger",        reads: Chem("hunger")),
    (id: 2,  name: "thirst",        reads: Chem("thirst")),
    (id: 3,  name: "pain",          reads: Chem("pain")),
    (id: 4,  name: "tiredness",     reads: Chem("tiredness")),
    (id: 5,  name: "boredom",       reads: Chem("boredom")),
    (id: 6,  name: "loneliness",    reads: Chem("loneliness")),
    (id: 7,  name: "crowdedness",   reads: Chem("crowdedness")),

    (id: 8,  name: "h0",            reads: Chem("h0")),
    (id: 9,  name: "h1",            reads: Chem("h1")),
    (id: 10, name: "h2",            reads: Chem("h2")),
    (id: 11, name: "h3",            reads: Chem("h3")),
    (id: 12, name: "h4",            reads: Chem("h4")),
    (id: 13, name: "h5",            reads: Chem("h5")),
    (id: 14, name: "h6",            reads: Chem("h6")),
    (id: 15, name: "h7",            reads: Chem("h7")),
    (id: 16, name: "h8",            reads: Chem("h8")),
    (id: 17, name: "h9",            reads: Chem("h9")),
    (id: 18, name: "h10",           reads: Chem("h10")),
    (id: 19, name: "h11",           reads: Chem("h11")),
    (id: 20, name: "h12",           reads: Chem("h12")),
    (id: 21, name: "h13",           reads: Chem("h13")),
    (id: 22, name: "h14",           reads: Chem("h14")),
    (id: 23, name: "h15",           reads: Chem("h15")),

    (id: 24, name: "nearby_sprites",reads: Locus("nearby_sprites")),
    (id: 25, name: "age",           reads: Locus("age")),
    (id: 26, name: "always",        reads: Locus("always")),

    (id: 27, name: "ate",           reads: Locus("ate")),
    (id: 28, name: "drank",         reads: Locus("drank")),
    (id: 29, name: "played",        reads: Locus("played")),
    (id: 30, name: "played_social", reads: Locus("played_social")),
    (id: 31, name: "pricked",       reads: Locus("pricked")),
    (id: 32, name: "was_hit",       reads: Locus("was_hit")),
    (id: 33, name: "did_hit",       reads: Locus("did_hit")),
    (id: 34, name: "petted",        reads: Locus("petted")),
    (id: 35, name: "shocked",       reads: Locus("shocked")),

    (id: 64, name: "cornered",      reads: Locus("cornered")),
    (id: 65, name: "fruitless",     reads: Locus("fruitless")),

    // Breeding (M2 design §10).
    (id: 66, name: "arousal",       reads: Chem("arousal")),
    (id: 67, name: "fertile",       reads: Locus("fertile")),
    (id: 68, name: "female",        reads: Locus("female")),
    (id: 69, name: "female_near",   reads: Locus("female_near")),
    (id: 70, name: "bred",          reads: Locus("bred")),
    // Body language: what the sprite attended to shows, 0 unless attention
    // is on a sprite that has hatched: how aroused it is, and whether it's
    // of the other sex.
    (id: 71, name: "target_arousal",   reads: Target(Chem("arousal"))),
    (id: 72, name: "target_other_sex", reads: Differs(Locus("female"))),
    // How long it's gone without seeing a male adult.
    (id: 73, name: "longing",       reads: Chem("longing")),

    // Calls and courtship (M2 design §15).
    (id: 74, name: "heard",         reads: Locus("heard")),
    (id: 75, name: "courted",       reads: Locus("courted")),
    (id: 76, name: "danced",        reads: Locus("danced")),
    (id: 77, name: "lost_partner",  reads: Locus("lost_partner")),
    (id: 78, name: "partner_near",  reads: Locus("partner_near")),
    (id: 79, name: "paired",        reads: Locus("paired")),
    (id: 80, name: "male_near",     reads: Locus("male_near")),
    (id: 81, name: "receptivity",   reads: Chem("receptivity")),
    (id: 82, name: "grief",         reads: Chem("grief")),
    // Body language: how healthy the sprite attended to looks, and how
    // receptive.
    (id: 83, name: "target_condition",   reads: Target(Locus("condition"))),
    (id: 84, name: "target_receptivity", reads: Target(Chem("receptivity"))),
    // What it knows of the sprite attended to: how well it knows it, from
    // 0 to 1, and 1 if it's its partner, or its kin (a parent, a young one,
    // or a sibling). A heard caller is read as if in sight.
    (id: 85, name: "target_familiar",    reads: Familiar),
    (id: 86, name: "target_partner",     reads: Partner),
    (id: 87, name: "target_kin",         reads: Kin),

    // Families (M2 design §15.6): the drive to keep near family, and what
    // the sprite senses of its family out of sight.
    (id: 88, name: "anxiety",       reads: Chem("anxiety")),
    (id: 89, name: "egg_away",      reads: Locus("egg_away")),
    (id: 90, name: "egg_alone",     reads: Locus("egg_alone")),
    (id: 91, name: "young_away",    reads: Locus("young_away")),
    (id: 92, name: "parent_away",   reads: Locus("parent_away")),
    (id: 93, name: "partner_away",  reads: Locus("partner_away")),
    // 1 while what it attends to is its family: its partner, its parents
    // while it's young, its young, or an egg of its own.
    (id: 94, name: "target_family", reads: Family),
    // A pulse on finding family it was missing.
    (id: 95, name: "found_family",  reads: Locus("found_family")),
],

// The needs (design v16 §5.2, §5.6): the drives whose relief teaches a
// sprite what things are good for, each a State input that reads a drive.
// Pain is a drive but not a need: its fall is a hurt fading, not relief.
needs: ["hunger", "thirst", "tiredness", "boredom", "loneliness", "crowdedness", "arousal", "anxiety"],

// The first-order needs (design v21 §5.2, §5.6): the needs that come before a
// sprite's likes. The more one presses, the less what it merely likes pulls,
// though never to nothing. The other needs are second-order.
first_order: ["hunger", "thirst"],
)
